{
  "headers": [
    {
      "source": "/(clients-logos|og|payment-logos)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)\\.(png|svg|jpg|jpeg|webp|avif|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    }
  ]
}
