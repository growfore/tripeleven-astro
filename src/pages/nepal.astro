---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import "../styles/nepal.css";

const title =
  "Website & trip management for Nepal travel agencies — TripEleven";
const description =
  "Build a branded website, publish trekking and tour packages, and accept bookings with TripEleven. Nepal plans start at NPR 2,000/month.";
const canonical = "https://tripeleven.com/nepal";
const plan = Astro.url.searchParams.get("plan");
const initialMessage =
  plan === "launch" || plan === "business"
    ? `I'm interested in the Nepal ${plan === "launch" ? "Launch" : "Business"} plan. Please share the next steps and final tax details.`
    : "";

const agencies = [
  {
    name: "Essence Treks",
    logo: "/clients-logos/essence-treks-logo.webp",
    image: "/clients/essence-treks.jpg",
    href: "https://essencetreksnepal.com",
  },
  {
    name: "Hi Nepal Treks",
    logo: "/clients-logos/hinepal-logo.avif",
    href: "https://hinepaltreks.com",
  },
  {
    name: "Into Nepal Treks",
    logo: "/clients-logos/intonepal-logo.png",
    href: "https://new.intonepaltreks.com",
  },
  {
    name: "Limestone Treks",
    logo: "/clients-logos/limestone-treks-logo-transparent.webp",
    image: "/clients/limestone-treks.jpg",
    href: "https://limestonetreks.com",
  },
  {
    name: "Lovely Trips",
    logo: "/clients-logos/lovely-trips-logo.webp",
    href: "https://lovelytrips.com.np",
  },
  {
    name: "Summit Luxury Treks",
    logo: "/clients-logos/summit-luxury-logo-white.webp",
    image: "/clients/summit-luxury-treks.jpg",
    href: "https://summitluxurytreks.com",
  },
  {
    name: "Walkthrough Nepal",
    logo: "/clients-logos/walkthrough-nepal-color-logo.svg",
    href: "https://walkthroughnepal.com",
  },
];
const features = [
  {
    title: "Trip builder",
    description:
      "Organize itineraries, trip facts, pricing, and FAQs in a guided workflow.",
    icon: "/nepal-icons/icon-01.svg",
  },
  {
    title: "Branded website",
    description:
      "Publish trips, stories, reviews, and your team under your own domain.",
    icon: "/nepal-icons/icon-02.svg",
  },
  {
    title: "Direct bookings",
    description: "Travelers can book trips directly from your website.",
    icon: "/nepal-icons/icon-03.svg",
  },
  {
    title: "Content publishing",
    description:
      "Keep your catalog and travel advice current from one dashboard.",
    icon: "/nepal-icons/icon-04.svg",
  },
  {
    title: "Bookings and payments",
    description:
      "Manage bookings and receive payments with your own Stripe keys.",
    icon: "/nepal-icons/icon-05.svg",
  },
  {
    title: "AI itinerary drafts",
    description:
      "Draft day-by-day itineraries, then review and edit before publishing.",
    icon: "/nepal-icons/icon-06.svg",
  },
];
const tabs = [
  {
    name: "Build trips",
    title: "Build detailed trips",
    first:
      "Keep trip facts, day-by-day itineraries, inclusions, pricing and FAQs together.",
    second: "Your team can review drafts and publish when everything is ready.",
    image: "/mockups/itinerary-form.png",
  },
  {
    name: "Publish your website",
    title: "Publish your own website",
    first: "Choose a template, colors, fonts and your own domain.",
    second:
      "Feature trips, introduce your team, and share useful travel advice.",
    image: "/mockups/website-demo-for-cta-card.png",
  },
  {
    name: "Manage bookings",
    title: "Turn visits into bookings",
    first: "Give travelers a direct way to book each trek or tour.",
    second: "Track bookings in your dashboard and follow up with travelers.",
    image: "/mockups/nepal-hero.png",
  },
];
const tools = [
  { label: "Trips", icon: "package-plus" },
  { label: "Website", icon: "layout-grid" },
  { label: "Bookings", icon: "check-circle" },
  { label: "Payments", icon: "tag" },
  { label: "AI drafts", icon: "sparkles" },
] as const;
const faqs = [
  {
    question: "Do I need coding skills?",
    answer:
      "No. Build your catalog, publish your website, and manage bookings from a dashboard.",
  },
  {
    question: "Can I use my own domain?",
    answer: "Yes. Launch and Business plans include a custom domain.",
  },
  {
    question: "How does my team manage bookings?",
    answer:
      "Travelers can book from trip pages. Your team can manage bookings in the dashboard.",
  },
];
const prices = [
  {
    amount: "NPR 18,000",
    period: "/year",
    name: "Launch",
    description:
      "For agencies building their online presence and trip catalog.",
    features: [
      "Up to 45 trips and 200 posts",
      "2 staff seats and 5 GB storage",
      "Own Stripe keys for payments",
      "Remove TripEleven branding and template",
    ],
    plan: "launch",
  },
  {
    amount: "NPR 38,000",
    period: "/year",
    name: "Business",
    badge: "Best Seller",
    description: "For larger catalogs and teams.",
    features: [
      "Unlimited trips and posts",
      "25 staff seats and 25 GB storage",
      "Read-only API access",
      "Get plan guidance",
    ],
    plan: "business",
  },
  {
    amount: "Let’s talk",
    period: "",
    name: "Custom setup",
    description: "Ask us about your setup and requirements.",
    features: [
      "Tell us about your catalog",
      "Discuss your team needs",
      "Review setup requirements",
      "Custom domain",
    ],
    plan: "",
  },
];
const liveAgencies = [agencies[0], agencies[3], agencies[5]];
---

<Layout {title} {description} {canonical} chrome={false}>
  <div class="nepal-page" id="top">
    <header class="nepal-header">
      <div class="nepal-container nepal-nav">
        <a href="#top" class="nepal-wordmark" aria-label="TripEleven home">
          <img
            src="/lettermark-logo.svg"
            width="340"
            height="65"
            alt="TripEleven"
          />
        </a>
        <nav class="nepal-desktop-nav" aria-label="Nepal navigation">
          <a href="#top">Home</a><a href="#features">Features</a><a
            href="#agencies">Agencies</a
          ><a href="#pricing">Pricing</a><a href="#contact">Contact</a>
        </nav>
        <a href="#contact" class="nepal-button nepal-nav-cta">Talk to us</a>
        <details class="nepal-mobile-nav">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile Nepal navigation">
            <a href="#top">Home</a><a href="#features">Features</a><a
              href="#agencies">Agencies</a
            ><a href="#pricing">Pricing</a><a href="#contact">Contact</a>
            <a href="#contact" class="nepal-button">Talk to us</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <section class="nepal-hero nepal-container">
        <div>
          <h1>
            Your next traveler starts with a <span class="nepal-highlight"
              >better website.</span
            >
          </h1>
          <p>
            Give every trek and tour a place to shine. Publish your trips, tell
            your story, and turn visits into bookings from one dashboard.
          </p>
          <a href="#pricing" class="nepal-button nepal-button-dark"
            >See Nepal plans</a
          >
          <p class="nepal-plan-note">
            Local plans from NPR 2,000/month or NPR 18,000/year.
          </p>
        </div>
        <img
          src="/mockups/nepal-hero.png"
          width="2245"
          height="1280"
          alt="TripEleven trip and website dashboard"
          fetchpriority="high"
          class="nepal-hero-image"
        />
      </section>

      <section
        class="nepal-brands"
        aria-label="Nepal agencies using TripEleven"
      >
        <div class="nepal-container nepal-brand-grid">
          {
            agencies.map((agency) => (
              <a
                href={agency.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`Visit ${agency.name}`}
                class="nepal-brand-card"
              >
                <img src={agency.logo} alt={agency.name} loading="lazy" />
              </a>
            ))
          }
        </div>
      </section>

      <section id="features" class="nepal-section nepal-container">
        <div class="nepal-section-heading">
          <h2>Everything your agency needs</h2><p>
            Build trips, publish a branded website, and manage traveler bookings
            from one connected workspace.
          </p>
        </div>
        <div class="nepal-feature-grid">
          {
            features.map((feature) => (
              <article class="nepal-feature-card">
                <>
                  <div class="nepal-feature-icon">
                    <img
                      src={feature.icon}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                    />
                  </div>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section class="nepal-section nepal-about nepal-container">
        <img
          src="/mockups/itinerary-form.png"
          width="1926"
          height="1286"
          loading="lazy"
          alt="TripEleven itinerary builder"
        />
        <div>
          <h2>
            A complete home for your <span class="nepal-highlight"
              >travel business</span
            >
          </h2><p>
            Build your trip catalog, publish your story, and give travelers a
            direct way to reach your team.
          </p>
          <div class="nepal-numbered">
            <span>01</span><div>
              <h3>Guided trip builder</h3><p>
                Itineraries, facts, pricing, and FAQs in one flow.
              </p>
            </div>
          </div>
          <div class="nepal-numbered">
            <span>02</span><div>
              <h3>Your brand and domain</h3><p>
                Choose your template, palette, fonts, and domain.
              </p>
            </div>
          </div>
        </div>
      </section>
      <section
        class="nepal-section nepal-about nepal-about-reverse nepal-container"
      >
        <div>
          <h2>
            Bring your trips and <span class="nepal-highlight"
              >bookings together</span
            >
          </h2><p>
            Build your trip catalog, publish your story, and give travelers a
            direct way to reach your team.
          </p><a class="nepal-text-link" href="#contact"
            >Talk to us <span aria-hidden="true">→</span></a
          >
        </div>
        <img
          src="/mockups/website-demo-for-cta-card.png"
          width="1944"
          height="1304"
          loading="lazy"
          alt="TripEleven agency website preview"
        />
      </section>

      <section
        class="nepal-section nepal-tabs nepal-container"
        aria-label="How TripEleven works"
      >
        <div
          class="nepal-tab-list"
          role="tablist"
          aria-label="TripEleven workflow"
        >
          {
            tabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`nepal-tab-${index}`}
                aria-controls={`nepal-panel-${index}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? "0" : "-1"}
                data-nepal-tab={index}
              >
                <span class="nepal-tab-number">0{index + 1}</span>
                {tab.name}
              </button>
            ))
          }
        </div>
        {
          tabs.map((tab, index) => (
            <div
              id={`nepal-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`nepal-tab-${index}`}
              data-nepal-panel={index}
              hidden={index !== 0}
              class="nepal-tab-panel"
            >
              <>
                <div>
                  <>
                    <h2>{tab.title}</h2>
                    <p>{tab.first}</p>
                    <p>{tab.second}</p>
                  </>
                </div>
                <img
                  src={tab.image}
                  width="1944"
                  height="1304"
                  loading="lazy"
                  alt={tab.title}
                />
              </>
            </div>
          ))
        }
      </section>

      <section class="nepal-section nepal-integration nepal-container">
        <div class="nepal-section-heading">
          <h2>Your agency tools, connected.</h2><p>
            Publish trips, accept bookings, and receive payments with tools your
            agency controls.
          </p>
        </div>
        <div class="nepal-tools">
          {
            tools.map((tool) => (
              <div>
                <>
                  <span class="nepal-tool-symbol">
                    <Icon name={tool.icon} class="nepal-tool-icon" />
                  </span>
                  <span>{tool.label}</span>
                </>
              </div>
            ))
          }
        </div>
      </section>

      <section class="nepal-section nepal-container">
        <div class="nepal-cta">
          <div>
            <h2>Ready to bring your agency online?</h2><p>
              Ask us about a Nepal plan, setup, or final tax details. We will
              help you get started.
            </p>
          </div>
          <div class="nepal-cta-action">
            <img
              src="/nepal-icons/shape-06.png"
              width="299"
              height="299"
              loading="lazy"
              alt=""
            />
            <a href="#contact" class="nepal-button nepal-button-dark"
              >Talk to us <span aria-hidden="true">→</span></a
            >
          </div>
        </div>
      </section>

      <section id="faq" class="nepal-section nepal-faq nepal-container">
        <div>
          <h2>
            Before You Get Started <span class="nepal-highlight">Questions</span
            >
          </h2><a class="nepal-text-link" href="#contact"
            >Ask a question <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="nepal-faq-list">
          {
            faqs.map((faq, index) => (
              <details name="nepal-faq" open={index === 0}>
                <>
                  <summary>
                    {faq.question}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <p>{faq.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>

      <section id="pricing" class="nepal-section nepal-container">
        <div class="nepal-section-heading">
          <h2>Plans for Nepal agencies</h2><p>
            Choose a plan for your catalog and team. Ask us about setup and
            final tax details.
          </p>
        </div>
        <div class="nepal-pricing-grid">
          {
            prices.map((price) => (
              <article
                class={
                  price.badge
                    ? "nepal-price-card nepal-price-card-featured"
                    : "nepal-price-card"
                }
              >
                <>
                  {price.badge && (
                    <span class="nepal-price-badge">{price.badge}</span>
                  )}
                  <h3>
                    {price.amount} <small>{price.period}</small>
                  </h3>
                  <h4>{price.name}</h4>
                  <p>{price.description}</p>
                  <ul>
                    {price.features.map((feature) => (
                      <li>
                        {price.plan === "business" && (
                          <Icon name="check-circle" class="nepal-price-check" />
                        )}
                        {feature}
                      </li>
                    ))}
                  </ul>
                  <a
                    class="nepal-text-link"
                    href={
                      price.plan ? `?plan=${price.plan}#contact` : "#contact"
                    }
                  >
                    Ask about this plan <span aria-hidden="true">→</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section id="contact" class="nepal-section nepal-contact nepal-container">
        <div class="nepal-contact-form">
          <h2>Ask about TripEleven</h2><ContactForm {initialMessage} compact />
        </div><aside>
          <h2>Contact us</h2><h3>Based in Nepal</h3><p>
            Supporting Nepal travel agencies
          </p><h3>Email Address</h3><p>
            <a href="mailto:hello@tripeleven.com">hello@tripeleven.com</a>
          </p><h3>Plan details</h3><p>
            <a href="#pricing">See Nepal pricing</a>
          </p>
        </aside>
      </section>

      <section id="agencies" class="nepal-section nepal-container">
        <div class="nepal-section-heading">
          <h2>See TripEleven in the world</h2><p>
            Visit live Nepal agency websites built with TripEleven.
          </p>
        </div><div class="nepal-live-grid">
          {
            liveAgencies.map((agency) => (
              <article>
                <>
                  <a href={agency.href} target="_blank" rel="noreferrer">
                    <>
                      <img
                        src={agency.image}
                        alt={`${agency.name} website`}
                        width="1440"
                        height="1800"
                        loading="lazy"
                      />
                      <h3>{agency.name}</h3>
                    </>
                  </a>
                  <p>
                    Visit a live Nepal trekking website built with TripEleven.
                  </p>
                </>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="nepal-footer">
      <div class="nepal-container nepal-footer-grid">
        <div>
          <a href="#top" class="nepal-wordmark" aria-label="TripEleven home">
            <img
              src="/lettermark-logo.svg"
              width="340"
              height="65"
              alt="TripEleven"
              loading="lazy"
            />
          </a><p>
            Build trips, publish your website, and manage traveler bookings in
            one workspace.
          </p><h3>Contact</h3><a href="mailto:hello@tripeleven.com"
            >hello@tripeleven.com</a
          >
        </div><div>
          <h3>Explore</h3><a href="#features">Features</a><a href="#agencies"
            >Agencies</a
          ><a href="#pricing">Nepal pricing</a>
        </div><div>
          <h3>Support</h3><a href="#contact">Contact us</a><a href="/privacy"
            >Privacy policy</a
          ><a href="/terms">Terms</a>
        </div><div>
          <h3>Get started</h3><p>
            Tell us about your agency and the trips you want to share.
          </p><a href="#contact" class="nepal-button">Talk to us</a>
        </div>
      </div><div class="nepal-container nepal-copyright">
        © {new Date().getFullYear()} TripEleven. All rights reserved.
      </div>
    </footer>
  </div>
</Layout>

<script>
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-nepal-tab]"),
  ];
  const panels = [
    ...document.querySelectorAll<HTMLElement>("[data-nepal-panel]"),
  ];
  function activateTab(index: number) {
    tabs.forEach((item, itemIndex) => {
      const selected = itemIndex === index;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
      panels[itemIndex].hidden = !selected;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateTab(index));
    tab.addEventListener("keydown", (event) => {
      const next =
        event.key === "ArrowRight"
          ? (index + 1) % tabs.length
          : event.key === "ArrowLeft"
            ? (index - 1 + tabs.length) % tabs.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? tabs.length - 1
                : -1;
      if (next < 0) return;
      event.preventDefault();
      activateTab(next);
      tabs[next].focus();
    });
  });
  document
    .querySelectorAll<HTMLAnchorElement>(".nepal-mobile-nav a")
    .forEach((link) =>
      link.addEventListener("click", () => {
        const menu = link.closest("details");
        if (menu) menu.open = false;
      }),
    );
</script>
