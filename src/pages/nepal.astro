---
import Layout from "../layouts/Layout.astro";
import Showcase from "../components/Showcase.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import ContactForm from "../components/ContactForm.astro";

const title =
  "Website & trip management for Nepal travel agencies — TripEleven";
const description =
  "Build a branded website, publish trekking and tour packages, and collect inquiries with TripEleven. Nepal agency plans start at NPR 1,750/month.";
const canonical = "https://tripeleven.com/nepal";
const plan = Astro.url.searchParams.get("plan");
const initialMessage =
  plan === "launch" || plan === "business"
    ? `I'm interested in the Nepal ${plan === "launch" ? "Launch" : "Business"} plan. Please share the next steps and final tax details.`
    : "";

const plans = [
  {
    name: "Launch",
    description:
      "For agencies building their online presence and trip catalog.",
    monthly: "NPR 1,750/month",
    yearly: "NPR 18,000/year",
    href: "?plan=launch#contact",
    features: [
      "Branded trip website & catalog",
      "Trip inquiries (email / WhatsApp)",
      "Up to 45 trips & 200 blog posts",
      "Custom domain",
      "Custom template, palette & fonts",
      "AI itinerary generation (BYO key)",
      "5 GB media storage",
      "2 staff seats",
      "Priority support",
    ],
  },
  {
    name: "Business",
    description: "For agencies managing a larger catalog and team.",
    monthly: "NPR 3,500/month",
    yearly: "NPR 38,000/year",
    href: "?plan=business#contact",
    features: [
      "Everything in Launch",
      "Unlimited trips & blog posts",
      "Read-only API access",
      "Large package catalogs",
      "Remove TripEleven branding",
      "25 GB media storage",
      "25 staff seats",
      "Priority support",
    ],
  },
];
---

<Layout {title} {description} {canonical}>
  <main id="top" class="mx-auto w-full max-w-[1510px] overflow-x-clip">
    <section class="bg-deep-navy text-white">
      <div class="page-container pt-16 lg:pt-24">
        <div
          class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-16"
        >
          <h1 class="max-w-4xl text-5xl leading-tight text-white lg:text-7xl">
            Your trips deserve a website that <span class="text-electric"
              >works as hard as you do.</span
            >
          </h1>
          <div>
            <p
              class="max-w-xl text-lg leading-relaxed text-light-blue lg:text-xl"
            >
              For Nepal trekking and tour agencies: publish packages, show
              travelers what makes your agency different, and receive inquiries
              from your own branded site. Manage it all in one place.
            </p>
            <a
              href="#pricing"
              class="mt-7 inline-flex items-center gap-2 rounded-lg bg-electric px-7 py-3.5 font-semibold text-deep-navy hover:bg-white"
            >
              See Nepal plans <Icon name="arrow-right" class="size-5" />
            </a>
            <p class="mt-4 text-sm text-light-blue">
              Local plans from NPR 1,750/month.
            </p>
          </div>
        </div>
        <div
          class="mt-12 overflow-hidden rounded-t-3xl bg-light-blue p-2 pb-0 sm:p-4 sm:pb-0 lg:mt-16"
        >
          <img
            src="/mockups/hero-image.png"
            width="1926"
            height="1286"
            alt="TripEleven dashboard for managing trips, bookings and website content"
            class="block h-auto w-full rounded-t-2xl"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      id="features"
      class="page-container py-16 lg:py-24"
      aria-labelledby="platform-heading"
    >
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="platform-heading" class="text-3xl text-deep-navy lg:text-4xl">
          From first visit to trip inquiry
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-deep-navy">
          Give each itinerary room to shine, keep your catalog current, and make
          it easy for travelers to inquire.
        </p>
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div
          class="rounded-2xl border border-border bg-light-blue p-3 shadow-lg shadow-deep-navy/10"
        >
          <img
            src="/mockups/itinerary-form.png"
            width="1926"
            height="1286"
            alt="TripEleven itinerary editor for tour and trekking packages"
            loading="lazy"
            class="h-auto w-full rounded-lg"
          />
        </div>
        <ol
          class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card"
        >
          <li class="flex gap-4 p-6">
            <span
              class="shrink-0 font-serif text-2xl font-bold text-electric"
              aria-hidden="true">01</span
            >
            <div>
              <h3 class="text-xl text-deep-navy">Build detailed trips</h3>
              <p class="mt-2 leading-relaxed text-deep-navy">
                Organize itinerary days, pricing tiers, FAQs, and trip
                information in one catalog.
              </p>
            </div>
          </li>
          <li class="flex gap-4 p-6">
            <span
              class="shrink-0 font-serif text-2xl font-bold text-electric"
              aria-hidden="true">02</span
            >
            <div>
              <h3 class="text-xl text-deep-navy">Publish under your brand</h3>
              <p class="mt-2 leading-relaxed text-deep-navy">
                Use your own domain, template, colors, and fonts for a site that
                feels like your agency.
              </p>
            </div>
          </li>
          <li class="flex gap-4 p-6">
            <span
              class="shrink-0 font-serif text-2xl font-bold text-electric"
              aria-hidden="true">03</span
            >
            <div>
              <h3 class="text-xl text-deep-navy">
                Hear from interested travelers
              </h3>
              <p class="mt-2 leading-relaxed text-deep-navy">
                Receive trip inquiries and follow up with travelers.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section
      class="bg-light-blue py-16 lg:py-24"
      aria-labelledby="website-heading"
    >
      <div class="page-container">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="website-heading" class="text-3xl text-deep-navy lg:text-4xl">
            More than a list of packages
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-deep-navy">
            Give travelers a place to explore your trips and learn who they’ll
            travel with before they send an inquiry.
          </p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article
            class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"
          >
            <img
              src="/mockups/featured-trips.png"
              width="1930"
              height="1290"
              loading="lazy"
              alt="Featured trips section in a TripEleven website"
              class="h-auto w-full"
            />
            <div class="p-6">
              <h3 class="text-xl text-deep-navy">Put your best trips first</h3>
              <p class="mt-3 leading-relaxed text-deep-navy">
                Feature treks and tours on your homepage, then let visitors
                browse your catalog and open a full page for each trip.
              </p>
            </div>
          </article>
          <article
            class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"
          >
            <img
              src="/mockups/info-pages.png"
              width="1944"
              height="1304"
              loading="lazy"
              alt="Agency information pages in a TripEleven website"
              class="h-auto w-full"
            />
            <div class="p-6">
              <h3 class="text-xl text-deep-navy">
                Show the people behind the trip
              </h3>
              <p class="mt-3 leading-relaxed text-deep-navy">
                Add agency information, team details, testimonials, and reviews
                so travelers can get to know your business.
              </p>
            </div>
          </article>
          <article
            class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"
          >
            <img
              src="/mockups/posts.png"
              width="1944"
              height="1304"
              loading="lazy"
              alt="Blog posts managed in TripEleven"
              class="h-auto w-full"
            />
            <div class="p-6">
              <h3 class="text-xl text-deep-navy">Keep sharing useful advice</h3>
              <p class="mt-3 leading-relaxed text-deep-navy">
                Publish destination guides, travel advice, and agency updates
                alongside your trip catalog. Manage both from one dashboard.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <div class="bg-off-white py-16 lg:py-24">
      <Showcase />
    </div>

    <section
      class="page-container py-16 lg:py-24"
      aria-labelledby="workflow-heading"
    >
      <div class="max-w-3xl">
        <h2 id="workflow-heading" class="text-3xl text-deep-navy lg:text-4xl">
          From a new itinerary to a real conversation
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-deep-navy">
          One workflow keeps your trips, website, and inquiries connected as
          your Nepal agency grows.
        </p>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <li class="border-t border-electric pt-5">
          <span
            class="font-serif text-3xl font-bold text-electric"
            aria-hidden="true">01</span
          >
          <h3 class="mt-3 text-xl text-deep-navy">Create the trip</h3>
          <p class="mt-2 leading-relaxed text-deep-navy">
            Add trip facts, day-by-day itinerary, inclusions, pricing, and FAQs
            with a structured editor.
          </p>
        </li>
        <li class="border-t border-electric pt-5">
          <span
            class="font-serif text-3xl font-bold text-electric"
            aria-hidden="true">02</span
          >
          <h3 class="mt-3 text-xl text-deep-navy">Make it yours</h3>
          <p class="mt-2 leading-relaxed text-deep-navy">
            Set your domain, choose a template, and apply your agency’s colors
            and fonts.
          </p>
        </li>
        <li class="border-t border-electric pt-5">
          <span
            class="font-serif text-3xl font-bold text-electric"
            aria-hidden="true">03</span
          >
          <h3 class="mt-3 text-xl text-deep-navy">Keep it current</h3>
          <p class="mt-2 leading-relaxed text-deep-navy">
            Review drafts, publish new trips, and update existing pages as your
            offerings change.
          </p>
        </li>
        <li class="border-t border-electric pt-5">
          <span
            class="font-serif text-3xl font-bold text-electric"
            aria-hidden="true">04</span
          >
          <h3 class="mt-3 text-xl text-deep-navy">Hear from travelers</h3>
          <p class="mt-2 leading-relaxed text-deep-navy">
            New inquiries land in your dashboard, ready for your team to follow
            up.
          </p>
        </li>
      </ol>
      <a
        href="#contact"
        class="mt-10 inline-flex items-center gap-2 font-semibold text-deep-navy underline decoration-electric underline-offset-4"
      >
        Talk to us about your agency <Icon name="arrow-right" class="size-5" />
      </a>
    </section>

    <section
      id="pricing"
      class="bg-deep-navy py-16 lg:py-24"
      aria-labelledby="pricing-heading"
    >
      <div class="page-container">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="pricing-heading" class="text-3xl text-white lg:text-4xl">
            Plans for Nepal based agencies
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-light-blue">
            Choose a plan for your catalog and team. Ask us about setup and
            final tax details before you commit.
          </p>
        </div>
        <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-2">
          {
            plans.map((plan) => (
              <article
                class={`relative flex flex-col rounded-xl bg-card p-7 shadow-lg sm:p-9 ${plan.name === "Business" ? "border-2 border-electric" : "border border-border"}`}
              >
                {plan.name === "Business" && (
                  <span class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full bg-electric px-4 py-1.5 text-xs font-bold text-deep-navy">
                    Best value
                  </span>
                )}
                <h3 class="text-2xl text-deep-navy">{plan.name}</h3>
                <p class="mt-2 text-deep-navy">{plan.description}</p>
                <p class="mt-7 text-2xl font-bold text-deep-navy sm:text-3xl">
                  {plan.monthly}
                </p>
                <p class="mt-1 text-base text-deep-navy">or {plan.yearly}</p>
                <ul class="my-8 space-y-3 text-sm leading-relaxed text-deep-navy">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <Icon
                        name="check"
                        class="mt-0.5 size-4 shrink-0 text-electric"
                      />
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={plan.href}
                  class={`mt-auto block rounded-lg px-6 py-3.5 text-center font-semibold ${plan.name === "Business" ? "bg-electric text-deep-navy hover:bg-light-blue" : "bg-deep-navy text-white hover:bg-navy"}`}
                >
                  Ask about {plan.name}
                </a>
              </article>
            ))
          }
        </div>
        <p class="mt-6 text-center text-sm leading-relaxed text-light-blue">
          Rates apply to Nepal based agencies. Final tax details are confirmed
          on inquiry.
        </p>
      </div>
    </section>

    <div class="bg-off-white py-16 lg:py-24">
      <Faq />
    </div>

    <section id="contact" class="page-container py-16 lg:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <h2 class="text-3xl text-deep-navy lg:text-4xl">
            Let’s get your agency online.
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-deep-navy">
            Ask about a Nepal plan, setup, or final tax details. We’ll get back
            to you.
          </p>
        </div>
        <div
          class="mt-10 overflow-hidden rounded-2xl shadow-xl shadow-deep-navy/10"
        >
          <ContactForm {initialMessage} />
        </div>
      </div>
    </section>
  </main>
</Layout>
