---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import PaymentLogos from "../components/site/PaymentLogos.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/site/SectionHead.astro";
import PathCard from "../components/site/PathCard.astro";
import PixelEdge from "../components/site/PixelEdge.astro";
import Shot from "../components/site/Shot.astro";
import Faq from "../components/site/Faq.astro";
import { asset, screenshotWidths, cardWidths, pictureProps } from "../lib/images";
import { clients, domain } from "../lib/clients";
import { getFeature, featureHref } from "../lib/features";
import { compare } from "../lib/plans";
import { container, section, h1, h4, lead, body, btnPrimary, btnSecondary, iconTile } from "../lib/ui";
import type { ComponentProps } from "astro/types";

type IconName = ComponentProps<typeof Icon>["name"];

const title = "Travel agency website and software in Nepal | TripEleven";
const description =
  "Website and booking software for Nepal trekking and travel agencies. Publish trekking packages, take bookings and payments. Plans from NPR 18,000/year.";
const canonical = "https://tripeleven.com/nepal";

const links = [
  { label: "Features", href: "#features" },
  { label: "Agencies", href: "#agencies" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
  { label: "Contact", href: "#contact" },
];

const features: { title: string; description: string; icon: IconName; slug: string }[] = [
  {
    title: "Trip builder",
    description: "Organize itineraries, trip facts, pricing, and FAQs in a guided workflow.",
    icon: "route",
    slug: "tour-itinerary-builder",
  },
  {
    title: "Branded website",
    description: "Publish trips, stories, reviews, and your team under your own domain.",
    icon: "globe",
    slug: "travel-website-branding",
  },
  {
    title: "Direct bookings",
    description: "Travelers can book trips directly from your website.",
    icon: "calendar",
    slug: "online-booking-software",
  },
  {
    title: "Content publishing",
    description: "Keep your catalog and travel advice current from one dashboard.",
    icon: "file-text",
    slug: "travel-blog-software",
  },
  {
    title: "Bookings and payments",
    description: "Manage bookings and receive payments with your own provider keys, or by bank transfer.",
    icon: "credit-card",
    slug: "tour-payments-online",
  },
  {
    title: "AI itinerary drafts",
    description: "Draft day-by-day itineraries, then review and edit before publishing.",
    icon: "sparkles",
    slug: "ai-itinerary-generator",
  },
];

const pick = (slugs: string[]) =>
  slugs.map((s) => {
    const f = getFeature(s)!;
    return { icon: f.icon, name: f.name, blurb: f.blurb, href: featureHref(f) };
  });

const faqs = [
  { q: "Do I need coding skills?", a: "No. Build your catalog, publish your website, and manage bookings from a dashboard." },
  { q: "Can I use my own domain?", a: "Yes. Launch and Business plans include a custom domain." },
  {
    q: "How does my team manage bookings?",
    a: "Travelers can book from trip pages. Your team can manage bookings in the dashboard.",
  },
  {
    q: "What is the difference between Launch and Business?",
    a: "Launch includes up to 45 trips, 200 posts, and 2 staff seats. Business includes unlimited trips and posts, generous staff seats and storage, and read-only API access.",
  },
  {
    q: "Can I update trips after publishing?",
    a: "Yes. Update trip details and travel advice from your dashboard to keep your website current.",
  },
  {
    q: "How do I receive payments?",
    a: "Add your own Stripe, PayPal, Razorpay or other provider keys, or accept bank transfers, then manage bookings and payments from your dashboard.",
  },
  {
    q: "Does AI publish itineraries for me?",
    a: "No. AI creates itinerary drafts for your team to review and edit before publishing.",
  },
  {
    q: "What if I need a custom setup?",
    a: "Tell us about your catalog, team, and setup requirements. We can discuss a custom option with you.",
  },
];

// NPR pricing. Show the renewal price plainly and never as a monthly figure
// (PRODUCT.md, "Nepal plans").
const prices = [
  {
    amount: "NPR 18,000",
    renewal: "NPR 24,000",
    name: "Launch",
    description: "For agencies building their online presence and trip catalog.",
    features: [
      "Up to 45 trips and 200 posts",
      "2 staff seats and 5 GB storage",
      "Own provider keys or bank transfer for payments",
      "Remove TripEleven branding and template",
    ],
    plan: "launch",
  },
  {
    amount: "NPR 38,000",
    renewal: "NPR 48,000",
    name: "Business",
    description: "For larger catalogs and teams.",
    features: ["Unlimited trips and posts", "Generous staff seats and storage*", "Read-only API access", "Get plan guidance"],
    plan: "business",
  },
  {
    amount: "Let's talk",
    name: "Custom setup",
    description: "Ask us about your setup and requirements.",
    features: ["Tell us about your catalog", "Discuss your team needs", "Review setup requirements", "Custom domain"],
    plan: "",
  },
];

// Nepal shows "Ask us" where the USD table lists fixed Business limits.
const nepalOverrides: Record<string, string> = {
  "Staff seats": "Ask us",
  "Media storage": "Ask us",
};

const contactRows = [
  { icon: "globe" as const, label: "Based in Nepal", value: "Supporting Nepal travel agencies" },
  { icon: "mail" as const, label: "Email", value: "hello@tripeleven.com", href: "mailto:hello@tripeleven.com" },
  { icon: "users" as const, label: "Telephone", value: "+977 9856085151", href: "tel:+9779856085151" },
];

const jsonLd = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
  {
    "@type": "SoftwareApplication",
    name: "TripEleven",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonical,
    offers: prices
      .filter((p) => p.renewal)
      .map((p) => ({
        "@type": "Offer",
        name: p.name,
        price: p.amount.replace(/[^0-9]/g, ""),
        priceCurrency: "NPR",
        areaServed: "NP",
      })),
  },
];
---

<Layout {title} {description} {canonical} {jsonLd} ogImage="/og/nepal.jpg" chrome={false}>
  <header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-xl">
    <nav aria-label="Nepal navigation" class:list={[container, "flex h-16 items-center gap-6"]}>
      <a href="#top" class="inline-flex shrink-0 items-center" aria-label="TripEleven, back to top">
        <img src="/lettermark-logo.svg" width="229" height="45" alt="" class="h-7 w-auto" />
      </a>
      <div class="hidden flex-1 items-center justify-center gap-1 lg:flex">
        {
          links.map((l) => (
            <a href={l.href} class="inline-flex min-h-9 items-center rounded-md px-2.5 text-[14px] text-coal transition-colors hover:bg-coal/5">
              {l.label}
            </a>
          ))
        }
      </div>
      <div class="ml-auto flex items-center gap-2 lg:ml-0">
        <a href="#contact" class={btnPrimary}>Talk to us</a>
        <details id="nepal-menu" class="group lg:hidden">
          <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-md bg-white ring-1 ring-line [&::-webkit-details-marker]:hidden">
            <Icon name="menu" class="size-5 group-open:hidden" />
            <Icon name="x" class="hidden size-5 group-open:block" />
            <span class="sr-only">Menu</span>
          </summary>
          <div class="absolute inset-x-0 top-full flex flex-col border-b border-line bg-paper px-5 py-3 shadow-xl">
            {links.map((l) => <a href={l.href} class="flex min-h-11 items-center text-[17px]">{l.label}</a>)}
          </div>
        </details>
      </div>
    </nav>
  </header>

  <main id="top" class="overflow-x-clip">
    <!-- Hero -->
    <section class:list={[container, "pt-6 lg:pt-10"]}>
      <div class="grid grid-cols-1 overflow-hidden rounded-2xl ring-1 ring-line lg:grid-cols-[1fr_1.1fr]">
        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-14">
          <p class="m-0 font-mono text-[13px] uppercase text-flag-red-ink">Trekking agency website and booking software, Nepal</p>
          <h1 class:list={[h1, "mt-5 text-[clamp(38px,4.2vw,58px)]"]}>Your next traveler starts with a better website.</h1>
          <p class:list={[lead, "mt-6 max-w-lg"]}>
            Give every trek and tour a place to shine. Publish your trips, tell
            your story, and turn visits into bookings from one dashboard.
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            <a href="#pricing" class:list={[btnPrimary, "min-h-10 px-4"]}>See Nepal plans</a>
            <a href="#contact" class:list={[btnSecondary, "min-h-10 px-4"]}>Talk to us</a>
          </div>
          <p class="m-0 mt-4 text-[13px] text-mute">Local plans start from NPR 18,000 for the first year.</p>
        </div>
        <div class="relative flex min-h-[380px] items-center justify-center bg-flag-red p-6 grid-paper sm:p-10">
          <PixelEdge side="left" class="text-flag-red" />
          <Picture
            {...pictureProps}
            src={asset("/mockups/nepal-hero.webp")}
            widths={screenshotWidths}
            sizes="(min-width: 900px) 46vw, 90vw"
            alt="TripEleven trip and website dashboard"
            loading="eager"
            fetchpriority="high"
            class="relative block h-auto w-full rounded-xl shadow-[0_30px_60px_-20px_rgba(22,22,22,0.45)]"
          />
        </div>
      </div>
    </section>

    <!-- Logos -->
    <section class:list={[container, "mt-6"]} aria-labelledby="live-heading">
      <div class="flex flex-col items-center gap-6 px-6 py-8 lg:px-8">
        <p id="live-heading" class="m-0 text-center text-[14px] text-coal">Nepal agencies on TripEleven</p>
        <ul class="m-0 flex w-full list-none flex-wrap items-center justify-center gap-x-10 gap-y-5 p-0 lg:gap-x-14">
          {
            clients
              .filter((c) => c.logo)
              .map((c) => (
                <li>
                  <a href={c.href} target="_blank" rel="noreferrer" title={c.name} class="block transition hover:opacity-80">
                    <img src={c.logo!.src} width={c.logo!.width} height={c.logo!.height} alt={c.name} loading="lazy" class:list={["h-8 w-auto max-w-[130px] object-contain", c.logo!.invert && "invert"]} />
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class={section} aria-labelledby="features-heading">
      <div class={container}>
        <SectionHead
          id="features-heading"
          align="split"
          tagline="Features"
          title="Everything your agency needs"
          text="Build trips, publish a branded website, and manage traveler bookings from one connected workspace."
        />
        <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => (
              <a href={featureHref(getFeature(f.slug)!)} class="group flex min-h-[200px] flex-col bg-paper p-7 transition-colors hover:bg-white">
                <span class={iconTile}><Icon name={f.icon} class="size-4" /></span>
                <h3 class:list={[h4, "mt-auto pt-10 text-[18px]"]}>{f.title}</h3>
                <p class:list={[body, "mt-2"]}>{f.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Payment providers -->
    <PaymentLogos />

    <!-- Workflow -->
    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="workflow-heading">
      <div class={container}>
        <SectionHead
          id="workflow-heading"
          align="split"
          tagline="How it works"
          title="A complete home for your travel business"
          text="Build your trip catalog, publish your story, and give travelers a direct way to reach your team."
        />
        <div class="mt-12 flex flex-col gap-6">
          <PathCard
            flag="yellow"
            icon="route"
            label="01 · Build trips"
            title="Build detailed trips"
            text="Keep trip facts, day-by-day itineraries, inclusions, pricing and FAQs together. Your team can review drafts and publish when everything is ready."
            href="/product/tour-itinerary-builder"
            linkLabel="Explore trip builder"
            cta={{ href: "#contact", label: "Talk to us" }}
            items={pick(["tour-itinerary-builder", "ai-itinerary-generator", "travel-media-library"])}
          >
            <Shot src="/mockups/itinerary-form.webp" alt="TripEleven trip builder editing a trek itinerary" />
          </PathCard>
          <PathCard
            flag="green"
            icon="globe"
            label="02 · Publish your website"
            title="Publish your own website"
            text="Choose a template, colors, fonts and your own domain. Feature trips, introduce your team, and share useful travel advice."
            href="/product/travel-website-branding"
            linkLabel="Explore your website"
            cta={{ href: "#contact", label: "Talk to us" }}
            items={pick(["travel-website-branding", "travel-blog-software", "tour-team-pages"])}
            reverse
          >
            <Shot src="/mockups/website-demo-for-cta-card.webp" alt="Walkthrough Nepal, an agency website published on TripEleven" />
          </PathCard>
          <PathCard
            flag="blue"
            icon="calendar"
            label="03 · Manage bookings"
            title="Turn visits into bookings"
            text="Give travelers a direct way to book each trek or tour. Track bookings in your dashboard, follow up with travelers, and receive payments with your own provider keys or bank transfer."
            href="/product/online-booking-software"
            linkLabel="Explore online booking"
            cta={{ href: "#contact", label: "Talk to us" }}
            items={pick(["online-booking-software", "tour-payments-online", "trip-inquiry-management"])}
          >
            <Shot src="/mockups/help/bookings.png" alt="TripEleven bookings list with trip, departure, travelers and payment status" />
          </PathCard>
        </div>
      </div>
    </section>

    <!-- Live agencies -->
    <section id="agencies" class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="agencies-heading">
      <div class={container}>
        <SectionHead
          id="agencies-heading"
          align="split"
          tagline="Live sites"
          title="See TripEleven in the world"
          text="Visit live Nepal agency websites built with TripEleven. Click through their treks, navigation and inquiry forms."
        />
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            clients.map((c) => (
              <a href={c.href} target="_blank" rel="noreferrer" class="group block overflow-hidden rounded-2xl ring-1 ring-line">
                <div class="overflow-hidden bg-white">
                  <Picture
                    {...pictureProps}
                    src={asset(c.image)}
                    widths={cardWidths}
                    sizes="(min-width: 1024px) 300px, (min-width: 640px) 46vw, 92vw"
                    alt={`${c.name} website homepage`}
                    class="block aspect-[4/3] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                </div>
                <div class="flex items-center gap-3 border-t border-line p-4">
                  <span class="min-w-0 flex-1">
                    <span class="block text-[15px] text-coal">{c.name}</span>
                    <span class="block text-[13px] text-mute underline decoration-line-strong underline-offset-2">{domain(c.href)}</span>
                  </span>
                  <Icon name="external-link" class="size-4 text-mute transition-colors group-hover:text-coal" />
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="pricing-heading">
      <div class={container}>
        <SectionHead
          id="pricing-heading"
          align="center"
          tagline="Nepal pricing"
          title="Plans for Nepal agencies"
          text="Yearly plans in NPR. Choose a plan for your catalog and team, and ask us about setup and final tax details."
        />
        <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-3">
          {
            prices.map((p, i) => (
              <article class:list={["relative flex flex-col overflow-hidden rounded-2xl p-8 lg:p-10", i === 1 ? "ring-2 ring-signal" : "ring-1 ring-line"]}>
                {i === 1 && <div class="absolute inset-x-0 top-0 h-2 bg-flag-blue grid-paper" />}
                <h3 class:list={["m-0 font-mono text-[13px] font-normal uppercase", i === 1 ? "text-signal" : "text-mute"]}>{p.name}</h3>
                <p class="m-0 mt-4 min-h-[52px] text-[16px] leading-relaxed text-mute">{p.description}</p>
                <div class="mt-8 min-h-[92px]">
                  <p class="m-0 font-display text-[44px] font-medium leading-none tracking-[-0.035em] text-coal">
                    {p.amount}
                    {p.renewal && <span class="text-[17px] tracking-normal text-mute"> /year</span>}
                  </p>
                  {p.renewal ? (
                    <p class="m-0 mt-3 text-[14px] text-mute">First year, then {p.renewal}/year</p>
                  ) : (
                    <p class="m-0 mt-3 text-[14px] text-mute">Tailored to your agency</p>
                  )}
                </div>
                <a href={p.plan ? `?plan=${p.plan}#contact` : "#contact"} class:list={["mt-8 min-h-11", i === 1 ? btnPrimary : btnSecondary]}>
                  Ask about this plan
                </a>
                <ul class="m-0 mt-8 flex list-none flex-col gap-3 border-t border-line p-0 pt-8">
                  {p.features.map((feature) => (
                    <li class="flex gap-3 text-[15px] leading-snug text-coal">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-signal" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <p class="m-0 mt-6 text-center text-[14px] text-mute">*Seats and storage scale with your catalog. Ask us for exact limits.</p>

        <div class="mt-12 overflow-x-auto rounded-2xl ring-1 ring-line">
          <table class="w-full min-w-[640px] border-collapse text-left">
            <thead>
              <tr class="border-b border-line">
                <th scope="col" class="w-2/5 p-5 font-mono text-[12px] font-normal uppercase text-mute lg:px-8">Feature</th>
                {["Launch", "Business", "Custom setup"].map((n) => <th scope="col" class="p-5 text-[16px] font-normal text-coal">{n}</th>)}
              </tr>
            </thead>
            {
              compare.map((g) => (
                <tbody>
                  <tr class="bg-paper-2/50">
                    <th scope="colgroup" colspan="4" class="px-5 py-3 font-mono text-[12px] font-normal uppercase text-mute lg:px-8">{g.title}</th>
                  </tr>
                  {g.rows.map(([label, ...vals]) => (
                    <tr class="border-t border-line">
                      <th scope="row" class="p-5 text-[15px] font-normal text-coal lg:px-8">{label}</th>
                      {vals.map((v, i) => {
                        const value = i === 1 && nepalOverrides[label] ? nepalOverrides[label] : v;
                        return (
                          <td class="p-5 text-[15px] text-coal">
                            {value === "✓" ? (
                              <>
                                <Icon name="check" class="size-5 text-signal" />
                                <span class="sr-only">Included</span>
                              </>
                            ) : value === "—" ? (
                              <span class="text-mute/60" aria-label="Not included">—</span>
                            ) : (
                              value
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="faq-heading">
      <div class={container}>
        <Faq items={faqs} title="Before you get started" contactHref="#contact" />
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="contact-heading">
      <div class={container}>
        <div class="grid grid-cols-1 overflow-hidden rounded-2xl ring-1 ring-line lg:grid-cols-[1fr_1.2fr]">
          <div class="relative flex flex-col bg-flag-red p-8 grid-paper sm:p-12">
            <div class="relative rounded-xl bg-paper p-8 ring-1 ring-line">
              <p class="m-0 font-mono text-[13px] uppercase text-flag-red-ink">Contact</p>
              <h2 id="contact-heading" class:list={[h1, "mt-4 text-[clamp(30px,3vw,42px)]"]}>Ask about TripEleven</h2>
              <p class:list={[body, "mt-4 text-[16px]"]}>
                Ask us about a Nepal plan, setup, or final tax details. We will help you get started.
              </p>
              <ul class="m-0 mt-8 flex list-none flex-col gap-5 p-0">
                {
                  contactRows.map((r) => (
                    <li class="flex gap-3">
                      <span class={iconTile}><Icon name={r.icon} class="size-4" /></span>
                      <span>
                        <span class="block text-[14px] text-mute">{r.label}</span>
                        {r.href ? (
                          <a href={r.href} class="text-[16px] text-coal underline decoration-line-strong underline-offset-4 hover:decoration-coal">{r.value}</a>
                        ) : (
                          <span class="text-[16px] text-coal">{r.value}</span>
                        )}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="p-8 sm:p-12">
            <ContactForm compact />
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class:list={[container, "flex flex-col gap-6 py-10 text-[14px] text-mute sm:flex-row sm:items-center sm:justify-between"]}>
      <div class="flex items-center gap-4">
        <img src="/lettermark-logo.svg" width="229" height="45" alt="TripEleven" class="h-6 w-auto" loading="lazy" />
        <span>© {new Date().getFullYear()} TripEleven</span>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/" class="hover:text-coal">Global site</a>
        <a href="/product" class="hover:text-coal">All features</a>
        <a href="mailto:hello@tripeleven.com" class="hover:text-coal">hello@tripeleven.com</a>
        <a href="/privacy" class="hover:text-coal">Privacy</a>
        <a href="/terms" class="hover:text-coal">Terms</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("#nepal-menu");
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.open = false;
    }),
  );
</script>
