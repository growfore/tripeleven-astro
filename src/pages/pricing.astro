---
import Layout from "../layouts/Layout.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import FloatingNav from "../components/FloatingNav.astro";

const title = "Pricing — TripEleven";
const description =
  "Try TripEleven free for 7 days. Compare Launch, Scale and Enterprise plans for your travel business.";
const ogTitle = "Pricing — TripEleven";
const ogDescription = "Plans for every stage of your travel business.";
const canonical = "https://tripeleven.com/pricing";
---

<Layout {title} {description} {ogTitle} {ogDescription} {canonical}>
  <div class="mx-auto w-full max-w-[1510px] overflow-x-clip bg-card">
    <FloatingNav />
    <main id="top">
      <Pricing heading="h1" />
      <Closing />
    </main>
  </div>
</Layout>