---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import PathCard from "../../components/site/PathCard.astro";
import Shot from "../../components/site/Shot.astro";
import Faq from "../../components/site/Faq.astro";
import { integrationFeatures, featureGroups, featureHref } from "../../lib/features";
import { content } from "../../lib/feature-content";
import { container, section, tagline, h1, lead, btnPrimary, btnSecondary, SIGNUP } from "../../lib/ui";

const title = "Integrations for tour operator software | TripEleven";
const description =
  "Connect TripEleven to the tools your agency already uses: Stripe for payments, AI for itinerary drafts, and WhatsApp, email and phone for trip inquiries.";
const canonical = "https://tripeleven.com/integration";

const firstSentence = (slug: string) => `${content[slug].summary.split(". ")[0]}.`;
const flagOf = (slug: string) => featureGroups.find((g) => g.slugs.includes(slug))!.flag;

const faqs = [
  {
    q: "Which integrations does TripEleven support?",
    a: "Payments through your own Stripe keys, AI itinerary drafts with Claude, and trip inquiries by form, email, phone and WhatsApp.",
  },
  {
    q: "Do payments go through TripEleven?",
    a: "No. Payments are received through your own Stripe keys, so they go to your Stripe account.",
  },
  {
    q: "Do I need my own AI key?",
    a: "On the Launch plan, AI itinerary generation uses an API key that you provide.",
  },
  {
    q: "Are integrations included in every plan?",
    a: "Bookings, payments with your own Stripe keys and trip inquiries are included on every plan. AI itinerary generation is listed on every plan as bring-your-own-key.",
  },
];

const jsonLd = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tripeleven.com/" },
      { "@type": "ListItem", position: 2, name: "Integrations", item: canonical },
    ],
  },
  {
    "@type": "ItemList",
    name: "TripEleven integrations",
    itemListElement: integrationFeatures.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.name,
      description: firstSentence(f.slug),
      url: `https://tripeleven.com${featureHref(f)}`,
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---

<Layout {title} {description} {canonical} {jsonLd}>
  <main id="top" class="overflow-x-clip">
    <section class:list={[container, "pt-16 text-center lg:pt-24"]}>
      <p class={tagline}>Integrations</p>
      <h1 class:list={[h1, "mx-auto mt-6 max-w-4xl"]}>Connect TripEleven to the tools your agency already uses</h1>
      <p class:list={[lead, "mx-auto mt-6 max-w-2xl"]}>
        Receive payments in your own Stripe account, draft itineraries with AI,
        and answer travelers on WhatsApp, email or phone. All from the same
        dashboard as your trips and website.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href={SIGNUP} target="_blank" rel="noreferrer" class:list={[btnPrimary, "min-h-10 px-4"]}>Start free trial</a>
        <a href="/product" class:list={[btnSecondary, "min-h-10 px-4"]}>Explore the product</a>
      </div>
      <ul class="m-0 mx-auto mt-12 flex max-w-3xl list-none flex-wrap justify-center gap-2 p-0">
        {
          integrationFeatures.map((f) => (
            <li>
              <a href={featureHref(f)} class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-1.5 text-[14px] text-coal ring-1 ring-line transition hover:ring-coal">
                <Icon name={f.icon} class="size-4" />
                {f.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class={section}>
      <div class:list={[container, "flex flex-col gap-6"]}>
        {
          integrationFeatures.map((f, i) => (
            <PathCard
              flag={flagOf(f.slug)}
              icon={f.icon}
              label={f.eyebrow}
              title={f.headline}
              text={firstSentence(f.slug)}
              href={featureHref(f)}
              linkLabel={`Explore ${f.name.toLowerCase()}`}
              items={f.benefits.map((b) => ({ icon: "check" as const, name: b.title, blurb: b.text, href: featureHref(f) }))}
              reverse={i % 2 === 1}
            >
              <Shot src={f.image} alt={`${f.name} in TripEleven`} />
            </PathCard>
          ))
        }
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="faq-heading">
      <div class={container}>
        <Faq items={faqs} title="Integration FAQs" />
      </div>
    </section>
  </main>
</Layout>
