---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import IntegrationLogo from "../../components/site/IntegrationLogo.astro";
import SectionHead from "../../components/site/SectionHead.astro";
import Shot from "../../components/site/Shot.astro";
import Faq from "../../components/site/Faq.astro";
import { integrationCards } from "../../lib/integrations";
import { container, section, tagline, h1, lead, btnPrimary, btnSecondary, SIGNUP } from "../../lib/ui";

const title = "Integrations for tour operator websites | TripEleven";
const description =
  "Connect WhatsApp, Tawk.to, Google Analytics, Google Tag Manager, Meta Pixel, Microsoft Clarity, Stripe, AI and SMTP email to your TripEleven tour website.";
const canonical = "https://tripeleven.com/integration";

const faqs = [
  {
    q: "Which integrations does TripEleven support?",
    a: "WhatsApp, Tawk.to live chat, Google Analytics 4, Google Tag Manager, Meta Pixel, Microsoft Clarity, a consent banner, Stripe payments, AI generation with Claude, OpenAI or Gemini, and email sending via SMTP.",
  },
  {
    q: "Where do I set up integrations?",
    a: "In the TripEleven dashboard, under Integrations. No code is needed.",
  },
  {
    q: "Do analytics load before visitors consent?",
    a: "The consent banner asks visitors before any analytics loads.",
  },
  {
    q: "Do payments go through TripEleven?",
    a: "No. Payments are collected with your own Stripe account.",
  },
  {
    q: "Which AI providers can I use?",
    a: "Bring your own Claude, OpenAI or Gemini key for AI itinerary generation.",
  },
];

const jsonLd = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tripeleven.com/" },
      { "@type": "ListItem", position: 2, name: "Integrations", item: canonical },
    ],
  },
  {
    "@type": "ItemList",
    name: "TripEleven integrations",
    itemListElement: integrationCards.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      description: c.blurb,
      url: `https://tripeleven.com${c.href}`,
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---

<Layout {title} {description} {canonical} {jsonLd}>
  <main id="top" class="overflow-x-clip">
    <section class:list={[container, "pt-16 text-center lg:pt-24"]}>
      <p class={tagline}>{integrationCards.length} integrations</p>
      <h1 class:list={[h1, "mx-auto mt-6 max-w-4xl"]}>Connect the tools your agency already uses</h1>
      <p class:list={[lead, "mx-auto mt-6 max-w-2xl"]}>
        Chat with travelers on WhatsApp or Tawk.to, measure your website with
        Google Analytics, GTM, Meta Pixel and Clarity, and add your own Stripe,
        AI and email accounts. All from Integrations in the dashboard.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href={SIGNUP} target="_blank" rel="noreferrer" class:list={[btnPrimary, "min-h-10 px-4"]}>Start free trial</a>
        <a href="/product" class:list={[btnSecondary, "min-h-10 px-4"]}>Explore the product</a>
      </div>
    </section>

    <section class:list={[container, "mt-14 lg:mt-16"]} aria-label="Integrations in the TripEleven dashboard">
      <div class="relative overflow-hidden rounded-2xl bg-flag-blue px-4 pt-8 grid-paper sm:px-12 sm:pt-12">
        <div class="mx-auto max-w-5xl">
          <Shot src="/mockups/help/integrations.png" alt="Integrations page in the TripEleven dashboard" sizes="(min-width: 1100px) 1024px, 92vw" class="rounded-b-none" />
        </div>
      </div>
    </section>

    <section class={section} aria-labelledby="all-heading">
      <div class={container}>
        <SectionHead
          id="all-heading"
          align="split"
          tagline="All integrations"
          title="Chat, analytics, payments, AI and email"
          text="Each integration is set up from the dashboard with no code. Open any one to see what it does and how to connect it."
        />
        <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-3">
          {
            integrationCards.map((c) => (
              <a href={c.href} class="group flex min-h-[210px] flex-col bg-paper p-7 transition-colors hover:bg-white">
                <div class="flex items-start justify-between gap-4">
                  <IntegrationLogo logo={c.logo} />
                  <span class="rounded-md px-2 py-1 font-mono text-[11px] uppercase text-mute ring-1 ring-line">{c.category}</span>
                </div>
                <h3 class="m-0 mt-auto pt-10 text-[18px] font-normal text-coal">{c.name}</h3>
                <p class="m-0 mt-1.5 text-[15px] leading-relaxed text-mute">{c.blurb}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-[14px] text-signal">
                  Learn more <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            ))
          }
          <a href="/contact" class="group relative flex min-h-[210px] flex-col overflow-hidden bg-flag-blue p-7 grid-paper sm:col-span-2 lg:col-span-2">
            <span class="relative inline-flex size-10 items-center justify-center rounded-lg bg-white text-coal ring-1 ring-line">
              <Icon name="mail" class="size-5" />
            </span>
            <h3 class="relative m-0 mt-auto pt-10 text-[18px] font-normal text-coal">Need another integration?</h3>
            <p class="relative m-0 mt-1.5 max-w-md text-[15px] leading-relaxed text-coal/80">Tell us which tool your agency uses and we will look at adding it.</p>
            <span class="relative mt-4 inline-flex items-center gap-1 text-[14px] text-coal">
              Talk to us <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="faq-heading">
      <div class={container}>
        <Faq items={faqs} title="Integration FAQs" />
      </div>
    </section>
  </main>
</Layout>
