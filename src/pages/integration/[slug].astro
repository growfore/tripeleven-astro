---
import FeaturePage from "../../components/site/FeaturePage.astro";
import IntegrationPage from "../../components/site/IntegrationPage.astro";
import { integrationFeatures } from "../../lib/features";
import { integrations } from "../../lib/integrations";

// Payments and AI have full feature pages; the rest use the integration template.
export function getStaticPaths() {
  return [
    ...integrationFeatures.map((feature) => ({ params: { slug: feature.slug }, props: { feature } })),
    ...integrations.map((integration) => ({ params: { slug: integration.slug }, props: { integration } })),
  ];
}

const { feature, integration } = Astro.props;
---

{feature ? <FeaturePage {feature} /> : integration && <IntegrationPage {integration} />}
