---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import FloatingNav from "../components/FloatingNav.astro";

const title = "Contact — TripEleven";
const description =
  "Contact TripEleven for a demo, Enterprise pricing or a question about the platform. Send us a message and we'll get back to you quickly.";
const ogTitle = "Contact — TripEleven";
const ogDescription = "Talk to the TripEleven team.";
const canonical = "https://tripeleven.com/contact";
---

<Layout {title} {description} {ogTitle} {ogDescription} {canonical}>
  <div class="mx-auto w-full max-w-[1510px] overflow-x-clip bg-card">
    <main class="px-5 pb-[80px] pt-[110px] text-center lg:px-[55px]">
      <h1 class="mx-auto max-w-[640px] font-serif text-[40px] leading-[1.03]">
        Let&apos;s get your agency live.
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-[17px] leading-[1.5] text-muted-foreground">
        Questions about the platform, a demo, or Enterprise pricing? Send us a message and
        we&apos;ll take it from there.
      </p>
      <div class="mx-auto mt-10 max-w-3xl text-left">
        <ContactForm />
        <p class="mt-8 text-center text-sm text-muted-foreground">
          Prefer email? Write to us directly at{" "}
          <a
            href="mailto:hello@tripeleven.com"
            class="font-medium text-foreground underline underline-offset-2"
          >
            hello@tripeleven.com
          </a>
        </p>
      </div>
    </main>
    <FloatingNav />
  </div>
</Layout>