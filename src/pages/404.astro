---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { container, tagline, h1, lead, btnPrimary, btnSecondary } from "../lib/ui";

const title = "Page not found — TripEleven";
const description = "The page you are looking for does not exist or has moved. Go back to the TripEleven homepage or explore features for tour and travel agencies.";
---

<Layout {title} {description} noindex={true}>
  <main id="top" class="relative overflow-hidden">
    <div class:list={[container, "relative flex min-h-[70vh] flex-col items-center justify-center py-24 text-center"]}>
      <p class={tagline}>404 · Off the trail</p>
      <h1 class:list={[h1, "mt-7"]}>This page doesn't exist</h1>
      <p class:list={[lead, "mt-6 max-w-lg"]}>It may have moved, or the link may be wrong. Head back and pick a route.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class={btnPrimary}>Go home <Icon name="arrow-right" class="size-4" /></a>
        <a href="/product" class={btnSecondary}>See features</a>
      </div>
    </div>
  </main>
</Layout>
