---
import Layout from "../layouts/Layout.astro";
import Notice from "../components/Notice.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Platform from "../components/Platform.astro";
import Integrations from "../components/Integrations.astro";
import Extras from "../components/Extras.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import FloatingNav from "../components/FloatingNav.astro";

const title = "TripEleven — Build, manage and sell trips online";
const description =
  "The platform for tour and trekking agencies. Build your catalog, publish a full website, and collect trip inquiries — no code, no developers.";
const ogTitle = "TripEleven — Build, manage and sell trips online";
const ogDescription = "The platform for tour and trekking agencies.";
const canonical = "https://tripeleven.com/";
---

<Layout {title} {description} {ogTitle} {ogDescription} {canonical}>
  <div class="mx-auto w-full max-w-[1510px] overflow-x-clip bg-card">
    <Notice />
    <FloatingNav />
    <main id="top">
      <Hero />
      <Showcase />
      <Platform />
      <Integrations />
      <Extras />
      <Pricing />
      <Faq />
      <Closing />
    </main>
    <Footer />
  </div>
</Layout>