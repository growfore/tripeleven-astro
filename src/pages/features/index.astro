---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import PathCard from "../../components/site/PathCard.astro";
import Shot from "../../components/site/Shot.astro";
import SectionHead from "../../components/site/SectionHead.astro";
import { features, featureGroups } from "../../lib/features";
import { content } from "../../lib/feature-content";
import { container, section, tagline, h1, lead, btnPrimary, btnSecondary, SIGNUP } from "../../lib/ui";

const title = "Tour operator software features | TripEleven";
const description =
  "Online booking, Stripe payments, trip inquiries, itinerary builder, AI itinerary generator, travel blog, trust signals and branding for tour and trekking agencies.";
const canonical = "https://tripeleven.com/features";
const firstSentence = (slug: string) => `${content[slug].summary.split(". ")[0]}.`;
const groupIcon = { sell: "calendar", build: "route", grow: "globe" } as const;

const jsonLd = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tripeleven.com/" },
      { "@type": "ListItem", position: 2, name: "Features", item: canonical },
    ],
  },
  {
    "@type": "ItemList",
    name: "TripEleven features",
    itemListElement: features.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.name,
      description: firstSentence(f.slug),
      url: `https://tripeleven.com/features/${f.slug}`,
    })),
  },
];
---

<Layout {title} {description} {canonical} {jsonLd}>
  <main id="top" class="overflow-x-clip">
    <section class:list={[container, "pt-16 text-center lg:pt-24"]}>
      <p class={tagline}>{features.length} features · one dashboard</p>
      <h1 class:list={[h1, "mx-auto mt-6 max-w-4xl"]}>Tour operator software, built around the trip</h1>
      <p class:list={[lead, "mx-auto mt-6 max-w-2xl"]}>
        TripEleven is an all-in-one platform for tour and trekking agencies.
        Build your trips, publish a branded website, take bookings and payments,
        and answer inquiries from one dashboard.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href={SIGNUP} target="_blank" rel="noreferrer" class:list={[btnPrimary, "min-h-10 px-4"]}>Start free trial</a>
        <a href="/pricing" class:list={[btnSecondary, "min-h-10 px-4"]}>See pricing</a>
      </div>
      <ul class="m-0 mx-auto mt-12 flex max-w-4xl list-none flex-wrap justify-center gap-2 p-0">
        {
          featureGroups.flatMap((g) => g.items).map((f) => (
            <li>
              <a href={`/features/${f.slug}`} class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-1.5 text-[14px] text-coal ring-1 ring-line transition hover:ring-coal">
                <Icon name={f.icon} class="size-4" />
                {f.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class={section}>
      <div class:list={[container, "flex flex-col gap-16 lg:gap-24"]}>
        {
          featureGroups.map((group, i) => {
            const [lead_] = group.items;
            return (
              <div id={group.key}>
                <SectionHead align="split" tagline={group.label} title={group.title} text={group.text} />
                <div class="mt-12">
                  <PathCard
                    flag={group.flag}
                    icon={groupIcon[group.key as keyof typeof groupIcon]}
                    label={lead_.name}
                    title={lead_.headline}
                    text={firstSentence(lead_.slug)}
                    href={`/features/${lead_.slug}`}
                    linkLabel={`Explore ${lead_.name.toLowerCase()}`}
                    items={group.items.slice(1).map((f) => ({ icon: f.icon, name: f.name, blurb: f.blurb, href: `/features/${f.slug}` }))}
                    reverse={i % 2 === 1}
                  >
                    <Shot src={lead_.image} alt={`${lead_.name} in TripEleven`} />
                  </PathCard>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
