---
import Icon from "./Icon.astro";

interface Plan {
  name: string;
  description: string;
  price: string;
  priceSuffix: string;
  annual?: { price: string; totalLabel: string };
  badge?: string;
  tone: string;
  dark?: boolean;
  cta: string;
  href: string;
  features: string[];
}

const plans: Plan[] = [
  {
    name: "Launch",
    description: "Everything you need to grow a real travel business online.",
    price: "$29",
    priceSuffix: "month",
    annual: { price: "$23", totalLabel: "$276 billed yearly" },
    tone: "bg-white shadow-md",
    cta: "Try 7 days free trial",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Branded trip website & catalog",
      "Trip inquiries (email / WhatsApp)",
      "Bookings & payments",
      "Up to 45 trips & 200 blog posts",
      "Custom domain",
      "Custom template, palette & fonts",
      "AI itinerary generation (BYO key)",
      "5 GB media storage",
      "2 staff seats",
      "Priority support",
    ],
  },
  {
    name: "Business",
    badge: "Most Popular",
    description: "For large agencies managing a big catalog of packages.",
    price: "$79",
    priceSuffix: "month",
    annual: { price: "$63", totalLabel: "$756 billed yearly" },
    tone: "bg-navy shadow-md",
    dark: true,
    cta: "Try 7 days free trial",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Everything in Launch",
      "Bookings & payments",
      "Unlimited trips & blog posts",
      "Read-only API access",
      "Large package catalogs",
      "Remove TripEleven branding",
      "25 GB media storage",
      "25 staff seats",
      "Priority support",
    ],
  },
  {
    name: "Enterprise",
    description: "White-label, dedicated onboarding and custom terms.",
    price: "",
    priceSuffix: "",
    tone: "bg-white shadow-md",
    cta: "Contact us",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Everything in Business",
      "Bookings & payments",
      "White-label (remove TripEleven)",
      "Unlimited storage",
      "Dedicated onboarding",
      "Custom volume & terms",
    ],
  },
];

const comparePlans = ["Launch", "Business", "Enterprise"] as const;

type CompareRow = {
  label: string;
  launch: string;
  business: string;
  enterprise: string;
};
type CompareGroup = { title: string; rows: CompareRow[] };

const compareGroups: CompareGroup[] = [
  {
    title: "Site & Branding",
    rows: [
      {
        label: "Branded trip website & catalog",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Custom domain",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Remove TripEleven branding",
        launch: "—",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Custom template, palette & fonts",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Content & Catalog",
    rows: [
      {
        label: "Trips",
        launch: "45",
        business: "Unlimited",
        enterprise: "Unlimited",
      },
      {
        label: "Blog posts",
        launch: "200",
        business: "Unlimited",
        enterprise: "Unlimited",
      },
      {
        label: "Large package catalogs",
        launch: "—",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Per-trip SEO fields",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Read-only API access",
        launch: "—",
        business: "Included",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Inquiries & Leads",
    rows: [
      {
        label: "Trip inquiries (email / WhatsApp)",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Bookings & payments",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Media & Storage",
    rows: [
      {
        label: "Media library with auto WebP",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Media storage",
        launch: "5 GB",
        business: "25 GB",
        enterprise: "Unlimited",
      },
    ],
  },
  {
    title: "AI",
    rows: [
      {
        label: "AI itinerary generation (BYO key)",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Receive payments via own Stripe keys",
        launch: "—",
        business: "—",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Team & Support",
    rows: [
      {
        label: "Staff seats",
        launch: "2",
        business: "25",
        enterprise: "Unlimited",
      },
      {
        label: "Priority support",
        launch: "Included",
        business: "Included",
        enterprise: "Included",
      },
      {
        label: "Dedicated onboarding",
        launch: "—",
        business: "—",
        enterprise: "Included",
      },
      {
        label: "White-label",
        launch: "—",
        business: "—",
        enterprise: "Included",
      },
    ],
  },
];

function compareValue(
  row: CompareRow,
  plan: (typeof comparePlans)[number],
): string {
  return row[plan.toLowerCase() as keyof CompareRow];
}

const Heading = Astro.props.heading ?? "h2";
---

<section id="pricing" class="py-12 text-center container mx-auto px-4">
  <Heading
    class="font-serif text-[32px] leading-[1.15] text-deep-navy lg:text-[40px]"
  >
    Start with a 7-day free trial.
  </Heading>
  <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-deep-navy">
    Build your branded website, trip catalog and inquiry engine. Choose a plan
    when your trial ends.
  </p>
  <div
    class="my-8 inline-flex rounded-full border border-light-blue bg-light-blue p-1.5"
    data-billing-toggle
  >
    <button
      type="button"
      class="cursor-pointer rounded-full px-6 py-3 text-base font-semibold text-deep-navy transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-electric sm:px-8"
      data-billing-monthly
      aria-pressed="false"
    >
      Monthly
    </button>
    <button
      type="button"
      class="cursor-pointer rounded-full bg-deep-navy px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-electric sm:px-8"
      data-billing-annual
      aria-pressed="true"
    >
      Yearly <small class="ml-1 font-bold text-deep-navy">Save 20%</small>
    </button>
  </div>
  <div class="grid grid-cols-1 gap-5 text-left lg:grid-cols-3">
    {
      plans.map((plan) => (
        <article
          class={`relative flex min-h-[520px] flex-col rounded-xl border px-7 pb-7 pt-14 transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg active:translate-y-0 active:scale-[0.98] ${plan.tone} ${plan.dark ? "border-navy text-white shadow-lg shadow-deep-navy/15" : "border-light-blue text-deep-navy"}`}
        >
          {plan.badge && (
            <span class="absolute left-1/2 -top-3 -translate-x-1/2 whitespace-nowrap rounded-full bg-electric px-4 py-1.5 text-xs font-semibold text-deep-navy shadow-sm">
              <Icon name="star" class="mr-1 inline size-3 fill-current" />
              {plan.badge}
            </span>
          )}
          <h3 class="m-0 mb-2 text-center font-serif text-[30px] font-bold">
            {plan.name}
          </h3>
          <p
            class={`m-0 text-center text-sm leading-relaxed ${plan.dark ? "text-light-blue" : "text-deep-navy"}`}
          >
            {plan.description}
          </p>
          {plan.price && (
            <div class="mt-7 text-center" data-price>
              {plan.annual && (
                <small
                  class={`block text-xs ${plan.dark ? "text-light-blue" : "text-deep-navy"}`}
                  data-total
                  hidden
                >
                  {plan.annual.totalLabel}
                </small>
              )}
              {plan.annual && (
                <del
                  class={`mr-2 text-xl ${plan.dark ? "text-light-blue" : "text-deep-navy"}`}
                  data-monthly-price
                >
                  {plan.price}
                </del>
              )}
              <strong
                class="text-[46px] leading-tight"
                data-price-amount
                data-monthly={plan.price}
                data-annual={plan.annual?.price}
              >
                {plan.annual ? plan.annual.price : plan.price}
              </strong>
              {plan.priceSuffix && (
                <small class="ml-1 font-bold">/ {plan.priceSuffix}</small>
              )}
            </div>
          )}
          <ul class="m-0 list-none space-y-1 py-6 text-sm leading-relaxed">
            {plan.features.map((feature) => (
              <li>
                <Icon name="check" class="mr-2 inline size-4 text-electric" />
                {feature}
              </li>
            ))}
          </ul>
          <a
            href={plan.href}
            target="_blank"
            rel="noreferrer"
            class={`mt-auto rounded-lg p-4 text-center font-semibold no-underline transition-[background-color,transform] duration-200 active:scale-[0.98] ${plan.dark ? "bg-electric text-deep-navy hover:bg-white" : "bg-deep-navy text-white hover:bg-navy"}`}
          >
            {plan.cta}
          </a>
        </article>
      ))
    }
  </div>
  <small class="mt-8 block text-sm leading-relaxed text-deep-navy">
    Yearly billing available on Launch and Business. Your first 7 days are free.
  </small>
  <div class="mx-auto mt-16 max-w-3xl text-center">
    <small
      class="text-xs font-semibold uppercase tracking-[0.2em] text-electric"
    >
      Full comparison
    </small>
    <h3 class="m-0 mt-2 font-serif text-[28px] text-deep-navy lg:text-[34px]">
      See exactly what every plan includes
    </h3>
    <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-deep-navy">
      Compare limits, publishing tools, storage, team access, and support.
    </p>
  </div>
  <div class="mt-8 text-left lg:hidden" data-pricing-tabs>
    <div
      class="grid grid-cols-3 rounded-full border border-light-blue bg-light-blue p-1.5"
      role="tablist"
      aria-label="Pricing tiers"
    >
      {
        comparePlans.map((plan, index) => (
          <button
            type="button"
            id={`pricing-tab-${plan.toLowerCase()}`}
            class={`cursor-pointer rounded-full px-2 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-electric ${index === 0 ? "bg-deep-navy text-white shadow-sm" : "text-deep-navy"}`}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`pricing-panel-${plan.toLowerCase()}`}
            tabindex={index === 0 ? "0" : "-1"}
            data-pricing-tab
          >
            {plan}
          </button>
        ))
      }
    </div>
    {
      comparePlans.map((plan, index) => (
        <div
          id={`pricing-panel-${plan.toLowerCase()}`}
          class="mt-4 overflow-hidden rounded-2xl border border-border bg-white shadow-lg shadow-deep-navy/10"
          role="tabpanel"
          aria-labelledby={`pricing-tab-${plan.toLowerCase()}`}
          hidden={index !== 0}
          data-pricing-panel
        >
          {compareGroups.map((group) => (
            <section
              aria-labelledby={`${plan.toLowerCase()}-${group.title.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and")}`}
            >
              <h3
                id={`${plan.toLowerCase()}-${group.title.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and")}`}
                class="border-t border-border bg-light-blue px-5 py-4 text-xs font-semibold uppercase tracking-wider text-deep-navy first:border-t-0"
              >
                {group.title}
              </h3>
              <dl>
                {group.rows.map((row) => {
                  const value = compareValue(row, plan);
                  return (
                    <div class="flex items-center justify-between gap-4 border-t border-border px-5 py-4 text-sm">
                      <dt class="font-medium text-deep-navy">{row.label}</dt>
                      <dd class="flex shrink-0 items-center gap-1.5 text-right font-semibold text-deep-navy">
                        {value === "Included" ? (
                          <>
                            <Icon
                              name="check-circle"
                              class="size-5 text-electric"
                            />
                            <span>Included</span>
                          </>
                        ) : value === "—" ? (
                          <>
                            <Icon name="x-circle" class="size-5 text-slate" />
                            <span class="text-slate">Not included</span>
                          </>
                        ) : (
                          value
                        )}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </section>
          ))}
        </div>
      ))
    }
  </div>
  <div
    class="mt-8 hidden overflow-x-auto rounded-2xl border border-border bg-white text-left shadow-xl shadow-deep-navy/10 lg:block"
  >
    <table class="w-full min-w-[760px] border-collapse text-base">
      <caption class="sr-only">
        Detailed feature comparison for Launch, Business, and Enterprise plans
      </caption>
      <thead>
        <tr class="border-b border-border bg-light-blue">
          <th class="w-[40%] px-6 py-5 text-left font-semibold text-deep-navy"
            >Feature</th
          >
          {
            comparePlans.map((plan) => (
              <th
                class={`px-6 py-5 text-left font-bold ${plan === "Business" ? "bg-deep-navy text-white" : "text-deep-navy"}`}
              >
                {plan}
                {plan === "Business" && (
                  <span class="mt-1 block text-xs font-medium text-light-blue">
                    Most popular
                  </span>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          compareGroups.map((group) => (
            <>
              <tr class="border-t border-border bg-light-blue">
                <td
                  colspan="4"
                  class="px-6 py-4 text-xs font-bold uppercase tracking-[0.16em] text-deep-navy"
                >
                  {group.title}
                </td>
              </tr>
              {group.rows.map((row) => (
                <tr class="border-t border-border transition-colors duration-150 hover:bg-off-white">
                  <td class="px-6 py-4 font-medium text-deep-navy">
                    {row.label}
                  </td>
                  {comparePlans.map((plan) => {
                    const value = compareValue(row, plan);
                    if (value === "Included") {
                      return (
                        <td
                          class={`px-6 py-4 ${plan === "Business" ? "bg-light-blue/40" : ""}`}
                        >
                          <span class="inline-flex items-center gap-2 font-semibold text-deep-navy">
                            <Icon
                              name="check-circle"
                              class="size-5 text-electric"
                            />
                            Included
                          </span>
                        </td>
                      );
                    }
                    if (value === "—") {
                      return (
                        <td
                          class={`px-6 py-4 ${plan === "Business" ? "bg-light-blue/40" : ""}`}
                        >
                          <span class="inline-flex items-center gap-2 text-slate">
                            <Icon name="x-circle" class="size-5" />
                            Not included
                          </span>
                        </td>
                      );
                    }
                    return (
                      <td
                        class={`px-6 py-4 font-semibold text-deep-navy ${plan === "Business" ? "bg-light-blue/40" : ""}`}
                      >
                        {value}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </>
          ))
        }
      </tbody>
    </table>
  </div>
  <small
    class="mx-auto mt-4 block max-w-3xl text-center text-xs leading-relaxed text-deep-navy"
  >
    <strong>TripEleven branding</strong> is the credit line (footer + &ldquo;Powered
    by TripEleven&rdquo; notice) shown on your published site and linked to tripeleven.com.
    It is shown on Launch, and fully removed on Business and Enterprise.
  </small>
</section>

<script>
  const root = document
    .querySelector("[data-billing-toggle]")
    ?.closest("section");
  const monthlyBtn = root?.querySelector("[data-billing-monthly]");
  const annualBtn = root?.querySelector("[data-billing-annual]");
  if (monthlyBtn && annualBtn) {
    const setActive = (isAnnual: boolean) => {
      for (const [button, active] of [
        [monthlyBtn, !isAnnual],
        [annualBtn, isAnnual],
      ] as const) {
        button.classList.toggle("bg-deep-navy", active);
        button.classList.toggle("text-white", active);
        button.classList.toggle("shadow-sm", active);
        button.classList.toggle("text-deep-navy", !active);
        button.setAttribute("aria-pressed", String(active));
      }
      root?.querySelectorAll("strong[data-price-amount]").forEach((el) => {
        const amount = el as HTMLElement;
        amount.textContent = isAnnual
          ? (amount.dataset.annual ?? amount.dataset.monthly ?? "")
          : (amount.dataset.monthly ?? "");
      });
      root
        ?.querySelectorAll("[data-monthly-price], [data-total]")
        .forEach((el) => {
          (el as HTMLElement).hidden = !isAnnual;
        });
    };
    monthlyBtn.addEventListener("click", () => setActive(false));
    annualBtn.addEventListener("click", () => setActive(true));
  }

  const tabs = Array.from(
    root?.querySelectorAll<HTMLButtonElement>("[data-pricing-tab]") ?? [],
  );
  const panels = Array.from(
    root?.querySelectorAll<HTMLElement>("[data-pricing-panel]") ?? [],
  );

  const selectTab = (selectedIndex: number) => {
    tabs.forEach((tab, index) => {
      const selected = index === selectedIndex;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
      tab.classList.toggle("bg-deep-navy", selected);
      tab.classList.toggle("text-white", selected);
      tab.classList.toggle("shadow-sm", selected);
      tab.classList.toggle("text-deep-navy", !selected);
      panels[index].hidden = !selected;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(index));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        return;
      }

      event.preventDefault();
      const nextIndex =
        event.key === "Home"
          ? 0
          : event.key === "End"
            ? tabs.length - 1
            : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
              tabs.length;
      selectTab(nextIndex);
      tabs[nextIndex].focus();
    });
  });
</script>
