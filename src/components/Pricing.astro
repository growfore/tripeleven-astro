---
import Icon from "./Icon.astro";

interface Plan {
  name: string;
  description: string;
  price: string;
  priceSuffix: string;
  annual?: { price: string; totalLabel: string };
  badge?: string;
  tone: string;
  cta: string;
  href: string;
  features: string[];
}

const plans: Plan[] = [
  {
    name: "Launch",
    description: "Everything you need to grow a real travel business online.",
    price: "$29",
    priceSuffix: "month",
    annual: { price: "$23", totalLabel: "$276 billed yearly" },
    tone: "bg-lime",
    cta: "Try 7 days free trial",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Branded trip website & catalog",
      "Trip inquiries (email / WhatsApp)",
      "Up to 45 trips & 200 blog posts",
      "Custom domain",
      "Custom template, palette & fonts",
      "AI itinerary generation (BYO key)",
      "5 GB media storage",
      "2 staff seats",
      "Priority support",
    ],
  },
  {
    name: "Scale",
    badge: "Most Popular",
    description: "For large agencies managing a big catalog of packages.",
    price: "$79",
    priceSuffix: "month",
    annual: { price: "$63", totalLabel: "$756 billed yearly" },
    tone: "bg-violet",
    cta: "Try 7 days free trial",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Everything in Launch",
      "Unlimited trips & blog posts",
      "Read-only API access",
      "Large package catalogs",
      "Remove TripEleven branding",
      "25 GB media storage",
      "25 staff seats",
      "Priority support",
    ],
  },
  {
    name: "Enterprise",
    description: "White-label, dedicated onboarding and custom terms.",
    price: "",
    priceSuffix: "",
    tone: "bg-peach",
    cta: "Contact us",
    href: "https://app.tripeleven.com/signup",
    features: [
      "Everything in Scale",
      "White-label (remove TripEleven)",
      "Unlimited storage",
      "Dedicated onboarding",
      "Custom volume & terms",
    ],
  },
];

const comparePlans = ["Launch", "Scale", "Enterprise"] as const;

type CompareRow = {
  label: string;
  launch: string;
  scale: string;
  enterprise: string;
};
type CompareGroup = { title: string; rows: CompareRow[] };

const compareGroups: CompareGroup[] = [
  {
    title: "Site & Branding",
    rows: [
      {
        label: "Branded trip website & catalog",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Custom domain",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Remove TripEleven branding",
        launch: "—",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Custom template, palette & fonts",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Content & Catalog",
    rows: [
      {
        label: "Trips",
        launch: "45",
        scale: "Unlimited",
        enterprise: "Unlimited",
      },
      {
        label: "Blog posts",
        launch: "200",
        scale: "Unlimited",
        enterprise: "Unlimited",
      },
      {
        label: "Large package catalogs",
        launch: "—",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Per-trip SEO fields",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Read-only API access",
        launch: "—",
        scale: "Included",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Inquiries & Leads",
    rows: [
      {
        label: "Trip inquiries (email / WhatsApp)",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Bookings & payments",
        launch: "—",
        scale: "—",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Media & Storage",
    rows: [
      {
        label: "Media library with auto WebP",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Media storage",
        launch: "5 GB",
        scale: "25 GB",
        enterprise: "Unlimited",
      },
    ],
  },
  {
    title: "AI",
    rows: [
      {
        label: "AI itinerary generation (BYO key)",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Receive payments via own Stripe keys",
        launch: "—",
        scale: "—",
        enterprise: "Included",
      },
    ],
  },
  {
    title: "Team & Support",
    rows: [
      {
        label: "Staff seats",
        launch: "2",
        scale: "25",
        enterprise: "Unlimited",
      },
      {
        label: "Priority support",
        launch: "Included",
        scale: "Included",
        enterprise: "Included",
      },
      {
        label: "Dedicated onboarding",
        launch: "—",
        scale: "—",
        enterprise: "Included",
      },
      {
        label: "White-label",
        launch: "—",
        scale: "—",
        enterprise: "Included",
      },
    ],
  },
];

function compareValue(
  row: CompareRow,
  plan: (typeof comparePlans)[number],
): string {
  return row[plan.toLowerCase() as keyof CompareRow];
}
---

<section
  id="pricing"
  class="px-5 py-[65px] text-center lg:px-[55px] lg:py-[95px]"
>
  <h2 class="m-0 font-serif text-[35px] lg:text-[48px]">
    Start with a 7-day free trial.
  </h2>
  <p class="mt-4 text-[17px] text-muted-foreground">
    Build your branded website, trip catalog and inquiry engine. Choose a plan
    when your trial ends.
  </p>
  <div
    class="my-10 inline-flex rounded-full border border-border bg-muted p-1.5 shadow-sm"
    data-billing-toggle
  >
    <button
      type="button"
      class="cursor-pointer rounded-full px-6 py-3 text-base font-semibold text-muted-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:px-8"
      data-billing-monthly
      aria-pressed="false"
    >
      Monthly
    </button>
    <button
      type="button"
      class="cursor-pointer rounded-full bg-primary px-6 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:px-8"
      data-billing-annual
      aria-pressed="true"
    >
      Yearly <small class="ml-1 font-bold">Save 20%</small>
    </button>
  </div>
  <div
    class="grid grid-cols-1 gap-[20px] text-left lg:grid-cols-3 lg:gap-[24px]"
  >
    {
      plans.map((plan) => (
        <article
          class={`relative flex min-h-[540px] flex-col rounded-2xl px-[28px] pb-0 pt-14 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${plan.tone}`}
        >
          {plan.badge && (
            <span class="absolute left-1/2 -top-2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-4 py-1 text-xs font-semibold text-primary-foreground">
              <Icon name="star" class="mr-1 inline size-3 fill-current" />
              {plan.badge}
            </span>
          )}
          <h3 class="m-0 mb-[10px] text-center font-serif text-[30px] font-bold">
            {plan.name}
          </h3>
          <p class="m-0 text-center text-[13px] leading-[1.5] text-foreground/70">
            {plan.description}
          </p>
          {plan.price && (
            <div class="mt-[28px] text-center" data-price>
              {plan.annual && (
                <small class="block text-muted-foreground" data-total hidden>
                  {plan.annual.totalLabel}
                </small>
              )}
              {plan.annual && (
                <del
                  class="mr-2 text-xl text-muted-foreground"
                  data-monthly-price
                >
                  {plan.price}
                </del>
              )}
              <strong
                class="text-[46px] leading-tight"
                data-price-amount
                data-monthly={plan.price}
                data-annual={plan.annual?.price}
              >
                {plan.annual ? plan.annual.price : plan.price}
              </strong>
              {plan.priceSuffix && (
                <small class="ml-1 font-bold">/ {plan.priceSuffix}</small>
              )}
            </div>
          )}
          <ul class="m-0 list-none py-[22px] text-[14px] leading-[2]">
            {plan.features.map((x) => (
              <li>
                <Icon name="check" class="mr-2 inline size-4 text-primary" />
                {x}
              </li>
            ))}
          </ul>
          <a
            href={plan.href}
            target="_blank"
            rel="noreferrer"
            class="mb-6 mt-auto cursor-pointer rounded-full bg-ink p-[18px] text-center font-semibold text-primary-foreground no-underline transition-colors duration-200 hover:opacity-85"
          >
            {plan.cta}
          </a>
        </article>
      ))
    }
  </div>
  <small class="mt-[35px] block leading-[1.8] text-muted-foreground">
    Yearly billing available on Launch and Scale. Your first 7 days are free.
  </small>
  <div class="mt-[60px] overflow-x-auto border border-border text-left">
    <table class="w-full min-w-[680px] border-collapse text-sm">
      <thead>
        <tr class="border-b bg-muted/50">
          <th class="px-4 py-3 text-left font-medium text-muted-foreground"
            >Feature</th
          >
          {
            comparePlans.map((plan) => (
              <th class="px-4 py-3 text-left font-semibold">{plan}</th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          compareGroups.map((group) => (
            <>
              <tr class="border-t bg-card">
                <td
                  colspan="4"
                  class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                  {group.title}
                </td>
              </tr>
              {group.rows.map((row) => (
                <tr class="border-t">
                  <td class="px-4 py-2.5 font-medium">{row.label}</td>
                  {comparePlans.map((plan) => {
                    const value = compareValue(row, plan);
                    if (value === "Included") {
                      return (
                        <td class="px-4 py-2.5">
                          <Icon name="check" class="size-4 text-primary" />
                        </td>
                      );
                    }
                    if (value === "—") {
                      return (
                        <td class="px-4 py-2.5">
                          <Icon
                            name="x"
                            class="size-4 text-muted-foreground/50"
                          />
                        </td>
                      );
                    }
                    return <td class="px-4 py-2.5">{value}</td>;
                  })}
                </tr>
              ))}
            </>
          ))
        }
      </tbody>
    </table>
  </div>
  <small
    class="mt-4 block text-center text-xs leading-[1.8] text-muted-foreground"
  >
    <strong>TripEleven branding</strong> is the credit line (footer + &ldquo;Powered
    by TripEleven&rdquo; notice) shown on your published site and linked to tripeleven.com.
    It is shown on Launch, and fully removed on Scale and Enterprise.
  </small>
</section>

<script>
  const root = document
    .querySelector("[data-billing-toggle]")
    ?.closest("section");
  const monthlyBtn = root?.querySelector("[data-billing-monthly]");
  const annualBtn = root?.querySelector("[data-billing-annual]");
  if (monthlyBtn && annualBtn) {
    const setActive = (isAnnual: boolean) => {
      for (const [button, active] of [
        [monthlyBtn, !isAnnual],
        [annualBtn, isAnnual],
      ] as const) {
        button.classList.toggle("bg-primary", active);
        button.classList.toggle("text-primary-foreground", active);
        button.classList.toggle("shadow-sm", active);
        button.classList.toggle("text-muted-foreground", !active);
        button.setAttribute("aria-pressed", String(active));
      }
      root?.querySelectorAll("strong[data-price-amount]").forEach((el) => {
        const amount = el as HTMLElement;
        amount.textContent = isAnnual
          ? (amount.dataset.annual ?? amount.dataset.monthly ?? "")
          : (amount.dataset.monthly ?? "");
      });
      root
        ?.querySelectorAll("[data-monthly-price], [data-total]")
        .forEach((el) => {
          (el as HTMLElement).hidden = !isAnnual;
        });
    };
    monthlyBtn.addEventListener("click", () => setActive(false));
    annualBtn.addEventListener("click", () => setActive(true));
  }
</script>
