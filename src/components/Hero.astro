---
import Icon from "./Icon.astro";
---

<section class="bg-off-white pt-12 lg:pt-20">
  <div
    class="page-container flex flex-col items-center pb-8 text-center lg:pb-12"
  >
    <h1
      class="mb-6 max-w-4xl font-serif text-[clamp(42px,6vw,64px)] font-semibold leading-[1.05] tracking-[-0.035em] text-deep-navy"
    >
      More <br />
      <span class="inline-grid align-top lg:whitespace-nowrap">
        <span
          class="col-start-1 row-start-1 transition-opacity duration-700 ease-in-out"
          data-hero-slide><span class="text-electric">trips sold.</span></span
        >
        <span
          class="col-start-1 row-start-1 opacity-0 transition-opacity duration-700 ease-in-out"
          data-hero-slide
          ><span class="text-electric">bookings made.</span></span
        >
        <span
          class="col-start-1 row-start-1 opacity-0 transition-opacity duration-700 ease-in-out"
          data-hero-slide
          ><span class="text-electric">revenue earned.</span></span
        >
        <span
          class="col-start-1 row-start-1 opacity-0 transition-opacity duration-700 ease-in-out"
          data-hero-slide><span class="text-electric">time saved.</span></span
        >
      </span>
      <br />
      <span>Less admin.</span>
    </h1>
    <p
      class="mb-7 max-w-[600px] text-lg leading-[1.55] text-deep-navy lg:text-xl"
    >
      Build your catalog, publish a full website, and collect trip inquiries —
      no code, no developers. From trekking agencies to DMCs, the platform for
      real operators.
    </p>
    <a
      href="https://app.tripeleven.com/signup"
      target="_blank"
      rel="noreferrer"
      class="group inline-flex items-center justify-center gap-3 rounded-lg bg-deep-navy px-7 py-3.5 text-base font-semibold text-white transition-colors duration-150 hover:bg-navy active:scale-[0.96]"
    >
      Try 7 days free
      <Icon
        name="arrow-right"
        class="size-5 transition-transform duration-200 group-hover:translate-x-1"
      />
    </a>
    <div
      class="mt-5 flex flex-col items-center gap-2 text-sm text-deep-navy sm:flex-row sm:gap-7"
    >
      <span class="flex items-center gap-2">
        <Icon
          name="check"
          class="size-5 rounded-full bg-electric p-1 text-deep-navy"
        />
        7-day free trial
      </span>
      <span class="flex items-center gap-2">
        <Icon
          name="check"
          class="size-5 rounded-full bg-electric p-1 text-deep-navy"
        />
        Cancel anytime
      </span>
    </div>
  </div>
  <div class="page-container mt-10">
    <img
      src="/mockups/hero-image.png"
      width="1926"
      height="1286"
      alt="TripEleven dashboard for managing trips, bookings and website content"
      class="block h-auto w-full"
      fetchpriority="high"
    />
  </div>
</section>

<script>
  const slides = Array.from(
    document.querySelectorAll<HTMLElement>("[data-hero-slide]"),
  );
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  if (slides.length) {
    slides.forEach((slide, i) =>
      slide.setAttribute("aria-hidden", String(i !== 0)),
    );
    if (!reduceMotion) {
      let active = 0;
      setInterval(() => {
        slides[active].classList.add("opacity-0");
        slides[active].setAttribute("aria-hidden", "true");
        active = (active + 1) % slides.length;
        slides[active].classList.remove("opacity-0");
        slides[active].setAttribute("aria-hidden", "false");
      }, 3000);
    }
  }
</script>
