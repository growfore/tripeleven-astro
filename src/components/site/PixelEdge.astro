---
// Stepped "pixel" edge that dissolves a graph-paper panel into the page,
// the way Relume's product panels do. Colour comes from a text-* class.
interface Props {
  side: "left" | "right" | "top" | "bottom";
  class?: string;
}
const { side, class: className } = Astro.props;
const id = `px-${Math.random().toString(36).slice(2, 8)}`;
const cell = 24;
// Cells per 10-cell run; column 0 touches the panel and is the densest.
const runs = [
  [0, 1, 3, 4, 6, 8, 9],
  [1, 4, 7],
  [3, 8],
];
const vertical = side === "left" || side === "right";
const rects = runs.flatMap((rows, depth) =>
  rows.map((i) => {
    const along = i * cell;
    const across = side === "left" || side === "top" ? (2 - depth) * cell : depth * cell;
    return vertical ? { x: across, y: along } : { x: along, y: across };
  }),
);
const box = vertical
  ? { w: cell * 3, h: cell * 10, style: `${side === "left" ? "right" : "left"}:100%;top:0;bottom:0;width:${cell * 3}px` }
  : { w: cell * 10, h: cell * 3, style: `${side === "top" ? "bottom" : "top"}:100%;left:0;right:0;height:${cell * 3}px` };
---

<svg class:list={["pointer-events-none absolute hidden lg:block", className]} style={box.style} aria-hidden="true">
  <defs>
    <pattern id={id} width={box.w} height={box.h} patternUnits="userSpaceOnUse">
      {rects.map((r) => <rect x={r.x} y={r.y} width={cell} height={cell} fill="currentColor" />)}
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
