---
import Icon from "../Icon.astro";
import { h2, body } from "../../lib/ui";

interface Props {
  items: { q: string; a: string }[];
  title: string;
  contactHref?: string;
}
const { items, title, contactHref = "/contact" } = Astro.props;
---

<div class="mx-auto max-w-3xl">
  <h2 id="faq-heading" class:list={[h2, "text-center"]}>{title}</h2>
  <div class="mt-12 border-t border-line-strong">
    {
      items.map(({ q, a }) => (
        <details class="group border-b border-line-strong">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
            <h3 class="m-0 text-[17px] font-normal leading-snug text-coal">{q}</h3>
            <Icon name="x" class="size-4 shrink-0 rotate-45 text-coal transition-transform duration-300 group-open:rotate-0" />
          </summary>
          <p class:list={[body, "max-w-2xl pb-6 pr-10"]}>{a}</p>
        </details>
      ))
    }
  </div>
  <p class:list={[body, "mt-8 text-center"]}>
    Still have a question?
    <a href={contactHref} class="text-coal underline decoration-line-strong underline-offset-4 hover:decoration-coal">Talk to the team</a>.
  </p>
</div>
