---
import Layout from "../../layouts/Layout.astro";
import Icon from "../Icon.astro";
import IntegrationLogo from "./IntegrationLogo.astro";
import SectionHead from "./SectionHead.astro";
import PixelEdge from "./PixelEdge.astro";
import Shot from "./Shot.astro";
import Faq from "./Faq.astro";
import { relatedLink, type Integration } from "../../lib/integrations";
import { container, section, tagline, h1, h4, lead, body, btnPrimary, btnSecondary, iconTile, SIGNUP } from "../../lib/ui";

interface Props {
  integration: Integration;
}
const { integration: it } = Astro.props;
const canonical = `https://tripeleven.com/integration/${it.slug}`;
const related = it.related.map(relatedLink);
const [summaryLead, ...summaryRest] = it.summary.split(/(?<=\.)\s/);
const facts = [
  { label: "Category", value: it.category },
  { label: "What you add", value: it.connectWith },
  { label: "Set up in", value: "Dashboard → Integrations" },
  { label: "Code needed", value: "None" },
];

const jsonLd = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tripeleven.com/" },
      { "@type": "ListItem", position: 2, name: "Integrations", item: "https://tripeleven.com/integration" },
      { "@type": "ListItem", position: 3, name: it.name, item: canonical },
    ],
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${canonical}#integration`,
    name: `TripEleven ${it.name} integration`,
    description: it.summary,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonical,
    isPartOf: { "@type": "SoftwareApplication", name: "TripEleven", url: "https://tripeleven.com/" },
    featureList: it.benefits.map((b) => `${b.title}: ${b.text}`),
  },
  {
    "@type": "HowTo",
    name: `How to connect ${it.name} to TripEleven`,
    step: it.setup.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.title, text: s.text })),
  },
  {
    "@type": "FAQPage",
    mainEntity: it.faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---

<Layout title={it.metaTitle} description={it.metaDescription} {canonical} {jsonLd}>
  <main id="top" class="overflow-x-clip">
    <section class:list={[container, "pt-8 lg:pt-10"]}>
      <nav aria-label="Breadcrumb" class="text-[13px] text-mute">
        <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
          <li><a href="/" class="hover:text-coal">Home</a></li>
          <li aria-hidden="true"><Icon name="chevron-right" class="size-3.5" /></li>
          <li><a href="/integration" class="hover:text-coal">Integrations</a></li>
          <li aria-hidden="true"><Icon name="chevron-right" class="size-3.5" /></li>
          <li aria-current="page" class="text-coal">{it.name}</li>
        </ol>
      </nav>

      <div class="mt-8 grid grid-cols-1 overflow-hidden rounded-2xl ring-1 ring-line lg:mt-10 lg:grid-cols-[1fr_1.1fr]">
        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-14">
          <IntegrationLogo logo={it.logo} class="size-12" />
          <p class="m-0 mt-5 font-mono text-[13px] uppercase text-signal">{it.category} integration</p>
          <h1 class:list={[h1, "mt-4 text-[clamp(34px,3.4vw,48px)]"]}>{it.headline}</h1>
          <p class:list={[lead, "mt-5 max-w-lg"]}>{it.intro}</p>
          <div class="mt-8 flex flex-wrap gap-2">
            <a href={SIGNUP} target="_blank" rel="noreferrer" class:list={[btnPrimary, "min-h-10 px-4"]}>Start free trial</a>
            <a href="/integration" class:list={[btnSecondary, "min-h-10 px-4"]}>All integrations</a>
          </div>
        </div>
        <div class="relative flex min-h-[340px] items-center justify-center bg-flag-blue p-6 grid-paper sm:p-10">
          <PixelEdge side="left" class="text-flag-blue" />
          <div class="relative w-full">
            <Shot src="/mockups/help/integrations.png" alt="Integrations page in the TripEleven dashboard" />
          </div>
        </div>
      </div>

      <dl class="m-0 mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line lg:grid-cols-4">
        {
          facts.map((fact) => (
            <div class="bg-paper p-6">
              <dt class="font-mono text-[12px] uppercase text-mute">{fact.label}</dt>
              <dd class="m-0 mt-2 text-[15px] leading-snug text-coal">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class={section} aria-labelledby="summary-heading">
      <div class={container}>
        <p class={tagline}>In short</p>
        <h2 id="summary-heading" class="sr-only">What does the {it.name} integration do?</h2>
        <p class="m-0 mt-6 max-w-5xl font-display text-[clamp(26px,2.8vw,38px)] font-medium leading-[1.3] tracking-[-0.02em] text-coal">
          {summaryLead}
          <span class="text-mute"> {summaryRest.join(" ")}</span>
        </p>
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="setup-heading">
      <div class={container}>
        <SectionHead id="setup-heading" align="split" tagline="Set up" title={`Connect ${it.name} in three steps`} text="Everything happens in the TripEleven dashboard. No developer and no code." />
        <ol class="m-0 mt-12 grid list-none grid-cols-1 gap-px overflow-hidden rounded-2xl bg-line p-0 ring-1 ring-line md:grid-cols-3">
          {
            it.setup.map((s, i) => (
              <li class="flex flex-col bg-paper p-7">
                <span class="font-mono text-[13px] text-signal">0{i + 1}</span>
                <h3 class:list={[h4, "mt-12 text-[18px]"]}>{s.title}</h3>
                <p class:list={[body, "mt-2"]}>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="benefits-heading">
      <div class={container}>
        <SectionHead id="benefits-heading" align="split" tagline="What you get" title={`Why connect ${it.name}`} text={it.blurb + "."} />
        <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line md:grid-cols-3">
          {
            it.benefits.map((b) => (
              <div class="flex min-h-[200px] flex-col bg-paper p-7">
                <span class={iconTile}><Icon name="check" class="size-4" /></span>
                <h3 class:list={[h4, "mt-auto pt-10 text-[18px]"]}>{b.title}</h3>
                <p class:list={[body, "mt-2"]}>{b.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="faq-heading">
      <div class={container}>
        <Faq items={it.faqs} title={`${it.name} integration FAQs`} />
      </div>
    </section>

    <section class:list={[section, "pt-0 lg:pt-0"]} aria-labelledby="related-heading">
      <div class={container}>
        <SectionHead id="related-heading" align="split" tagline="Works with" title="Related integrations and features" text="Combine integrations to fit how your agency talks to travelers and measures results." />
        <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            related.map((r) => (
              <a href={r.href} class="group flex items-start gap-4 rounded-2xl p-6 ring-1 ring-line transition hover:bg-white">
                <IntegrationLogo logo={r.logo} />
                <span class="min-w-0 flex-1">
                  <span class="block text-[16px] text-coal">{r.name}</span>
                  <span class="mt-1 block text-[14px] text-mute">{r.blurb}</span>
                </span>
                <Icon name="arrow-right" class="mt-1 size-4 text-mute transition group-hover:translate-x-0.5 group-hover:text-coal" />
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
