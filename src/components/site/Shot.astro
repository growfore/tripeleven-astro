---
// Real product screenshot sitting on a graph-paper panel.
import { Picture } from "astro:assets";
import { asset, screenshotWidths, pictureProps } from "../../lib/images";

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  /** Show only the top of a tall full-page screenshot. */
  crop?: boolean;
  class?: string;
}
const { src, alt, sizes = "(min-width: 1024px) 560px, 90vw", crop = false, class: className } = Astro.props;
---

<Picture
  {...pictureProps}
  src={asset(src)}
  widths={screenshotWidths}
  {sizes}
  {alt}
  class:list={["block w-full rounded-xl shadow-[0_30px_60px_-20px_rgba(22,22,22,0.45)]", crop ? "aspect-[4/3] object-cover object-top" : "h-auto", className]}
/>
