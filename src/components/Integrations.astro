---
import FeatureStack from "./FeatureStack.jsx";
---

<section id="features" class="page-container bg-off-white text-left">
  <small
    class="text-xs font-semibold uppercase tracking-[0.25em] text-deep-navy"
  >
    Features
  </small>
  <h2
    class="m-0 max-w-lg font-serif text-[32px] leading-[1.15] text-deep-navy lg:text-[40px]"
  >
    One workspace for your whole travel business
  </h2>
  <p
    class="m-0 mt-4 max-w-lg text-base leading-relaxed text-deep-navy lg:text-lg"
  >
    Every part below works with the next — build your catalog, publish your
    website, and take bookings without stitching tools together.
  </p>
  <FeatureStack client:load />
</section>
