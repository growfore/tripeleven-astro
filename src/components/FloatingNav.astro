---
import Notice from "../components/Notice.astro";
import Icon from "./Icon.astro";

const isNepal = Astro.url.pathname.replace(/\/$/, "") === "/nepal";
---

<header
  class="sticky top-0 z-50 bg-background/95 backdrop-blur-xl shadow w-full"
>
  {!isNepal && <Notice />}
  <nav
    aria-label="Main navigation"
    class="flex items-center justify-between gap-6 py-4 container mx-auto px-2"
  >
    <a
      href={isNepal ? "#top" : "/"}
      class="shrink-0"
      aria-label={isNepal ? "TripEleven — back to top" : "TripEleven home"}
    >
      <img
        src="/lettermark-logo.svg"
        width="229"
        height="45"
        alt=""
        class="h-8 w-auto"
      />
    </a>
    <div class="hidden items-center gap-8 md:flex">
      <a
        href={isNepal ? "#features" : "/#features"}
        class="nav-link text-sm text-deep-navy">Features</a
      >
      <a
        href={isNepal ? "#pricing" : "/pricing"}
        class="nav-link text-sm text-deep-navy">Pricing</a
      >
      <a
        href={isNepal ? "#faq" : "/#faq"}
        class="nav-link text-sm text-deep-navy">FAQ</a
      >
    </div>
    <div class="hidden items-center gap-3 md:flex">
      {
        isNepal ? (
          <a
            href="#contact"
            class="rounded-lg bg-deep-navy px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-navy"
          >
            Contact us
          </a>
        ) : (
          <>
            <a
              href="https://app.tripeleven.com/login"
              target="_blank"
              rel="noreferrer"
              class="rounded-lg px-3 py-2 text-sm font-semibold text-deep-navy hover:text-navy"
            >
              Log in
            </a>
            <a
              href="https://app.tripeleven.com/signup"
              target="_blank"
              rel="noreferrer"
              class="rounded-lg bg-deep-navy px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-navy"
            >
              Start free
            </a>
          </>
        )
      }
    </div>
    <details id="mobile-menu" class="group md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-lg border border-light-blue bg-white p-2.5 text-deep-navy [&::-webkit-details-marker]:hidden"
        ><Icon
          name="menu"
          class="size-5 group-open:hidden"
        /><Icon
          name="x"
          class="hidden size-5 group-open:block"
        /><span class="sr-only">Menu</span></summary
      >
      <div
        class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-light-blue bg-white px-5 py-4 shadow-xl"
      >
        <a
          href={isNepal ? "#features" : "/#features"}
          class="rounded-lg px-3 py-2 hover:bg-light-blue">Features</a
        >
        <a
          href={isNepal ? "#pricing" : "/#pricing"}
          class="rounded-lg px-3 py-2 hover:bg-light-blue">Pricing</a
        >
        <a
          href={isNepal ? "#faq" : "/#faq"}
          class="rounded-lg px-3 py-2 hover:bg-light-blue">FAQ</a
        >
        {
          isNepal ? (
            <a
              href="#contact"
              class="rounded-lg bg-deep-navy px-3 py-2 text-center font-semibold text-white"
            >
              Contact us
            </a>
          ) : (
            <>
              <a
                href="https://app.tripeleven.com/login"
                target="_blank"
                rel="noreferrer"
                class="rounded-lg px-3 py-2 hover:bg-light-blue"
              >
                Log in
              </a>
              <a
                href="https://app.tripeleven.com/signup"
                target="_blank"
                rel="noreferrer"
                class="rounded-lg bg-deep-navy px-3 py-2 text-center font-semibold text-white"
              >
                Start free
              </a>
            </>
          )
        }
      </div>
    </details>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("#mobile-menu");
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.open = false;
    }),
  );
</script>
