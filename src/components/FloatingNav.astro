---
import Notice from "../components/Notice.astro";
import Icon from "./Icon.astro";

const isNepal = Astro.url.pathname.replace(/\/$/, "") === "/nepal";
---

{!isNepal && <Notice />}
<header
  class="sticky top-0 z-50 bg-background/95 backdrop-blur-xl shadow w-full"
>
  <nav
    aria-label="Main navigation"
    class="flex items-center justify-between gap-2 py-3 container mx-auto px-3 sm:gap-4 sm:px-4 md:gap-6 md:px-2 md:py-4"
  >
    <a
      href={isNepal ? "#top" : "/"}
      class="inline-flex shrink-0 items-center pointer-coarse:min-h-11"
      aria-label={isNepal ? "TripEleven — back to top" : "TripEleven home"}
    >
      <img
        src="/lettermark-logo.svg"
        width="229"
        height="45"
        alt=""
        class="h-7 w-auto sm:h-8"
      />
    </a>
    <div class="hidden items-center gap-8 md:flex">
      <a
        href={isNepal ? "#features" : "/#features"}
        class="nav-link text-sm text-deep-navy pointer-coarse:py-3">Features</a
      >
      <a
        href={isNepal ? "#pricing" : "/pricing"}
        class="nav-link text-sm text-deep-navy pointer-coarse:py-3">Pricing</a
      >
      <a
        href={isNepal ? "#faq" : "/#faq"}
        class="nav-link text-sm text-deep-navy pointer-coarse:py-3">FAQ</a
      >
    </div>
    <div class="hidden items-center gap-3 md:flex">
      {
        isNepal ? (
          <a
            href="#contact"
            class="inline-flex items-center rounded-lg bg-deep-navy px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-navy pointer-coarse:min-h-11"
          >
            Contact us
          </a>
        ) : (
          <>
            <a
              href="https://app.tripeleven.com/login"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-semibold text-deep-navy hover:text-navy pointer-coarse:min-h-11"
            >
              Log in
            </a>
            <a
              href="https://app.tripeleven.com/signup"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center rounded-lg bg-deep-navy px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-navy pointer-coarse:min-h-11"
            >
              Start free
            </a>
          </>
        )
      }
    </div>
    <div class="flex items-center gap-2 md:hidden">
    <a
      href={isNepal ? "#contact" : "https://app.tripeleven.com/signup"}
      target={isNepal ? undefined : "_blank"}
      rel={isNepal ? undefined : "noreferrer"}
      class="inline-flex min-h-11 items-center whitespace-nowrap rounded-lg bg-deep-navy px-3 text-sm sm:px-4 font-semibold text-white shadow-sm hover:bg-navy"
    >
      {isNepal ? "Contact us" : "Start free"}
    </a>
    <details id="mobile-menu" class="group">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border border-light-blue bg-white text-deep-navy [&::-webkit-details-marker]:hidden"
        ><Icon
          name="menu"
          class="size-5 group-open:hidden"
        /><Icon
          name="x"
          class="hidden size-5 group-open:block"
        /><span class="sr-only">Menu</span></summary
      >
      <div
        class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-light-blue bg-white px-5 py-4 shadow-xl"
      >
        <a
          href={isNepal ? "#features" : "/#features"}
          class="flex min-h-11 items-center rounded-lg px-3 hover:bg-light-blue">Features</a
        >
        <a
          href={isNepal ? "#pricing" : "/pricing"}
          class="flex min-h-11 items-center rounded-lg px-3 hover:bg-light-blue">Pricing</a
        >
        <a
          href={isNepal ? "#faq" : "/#faq"}
          class="flex min-h-11 items-center rounded-lg px-3 hover:bg-light-blue">FAQ</a
        >
        {
          isNepal ? (
            <a
              href="#contact"
              class="flex min-h-11 items-center justify-center rounded-lg bg-deep-navy px-3 font-semibold text-white"
            >
              Contact us
            </a>
          ) : (
            <>
              <a
                href="https://app.tripeleven.com/login"
                target="_blank"
                rel="noreferrer"
                class="flex min-h-11 items-center rounded-lg px-3 hover:bg-light-blue"
              >
                Log in
              </a>
              <a
                href="https://app.tripeleven.com/signup"
                target="_blank"
                rel="noreferrer"
                class="flex min-h-11 items-center justify-center rounded-lg bg-deep-navy px-3 font-semibold text-white"
              >
                Start free
              </a>
            </>
          )
        }
      </div>
    </details>
    </div>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("#mobile-menu");
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.open = false;
    }),
  );
</script>
