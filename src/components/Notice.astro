---
import Icon from "./Icon.astro";
---

<div
  class="relative z-[60] flex min-h-9 items-center justify-center bg-deep-navy px-6 py-1.5 text-center text-xs text-white"
>
  <p class="m-0">
    <span class="hidden sm:inline">See a live agency website built on TripEleven:</span>
    <span class="sm:hidden">Live example:</span>{" "}
    <a
      href="https://walkthroughnepal.com"
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center gap-1 py-1 font-semibold text-electric underline decoration-electric/40 underline-offset-4 hover:text-white"
    >
      Walkthrough Nepal <Icon name="arrow-right" class="size-3.5" />
    </a>
  </p>
</div>
