---
import Icon from "./Icon.astro";

const TOPICS = [
  "General question",
  "Enterprise quote",
  "Walkthrough / demo",
  "Something else",
];
const CONTACT_EMAIL = "hello@tripeleven.com";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<form
  data-contact-form
  class:list={[
    "min-w-0",
    compact ? "" : "border border-border bg-card p-8 sm:p-10",
  ]}
>
  <input
    type="text"
    name="_honey"
    tabindex="-1"
    autocomplete="off"
    class="hidden"
  />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-2 block font-mono text-[12px] font-medium uppercase text-mute"
        >Full name</label
      >
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="120"
        required
        class="w-full rounded-lg bg-white px-4 py-3 text-coal ring-1 ring-line-strong placeholder:text-mute/60 outline-none transition focus:ring-2 focus:ring-signal"
        placeholder="Jane Doe"
      />
    </div>
    <div>
      <label for="email" class="mb-2 block font-mono text-[12px] font-medium uppercase text-mute">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
        class="w-full rounded-lg bg-white px-4 py-3 text-coal ring-1 ring-line-strong placeholder:text-mute/60 outline-none transition focus:ring-2 focus:ring-signal"
        placeholder="you@agency.com"
      />
    </div>
  </div>

  <div class="mt-5">
    <label for="agency" class="mb-2 block font-mono text-[12px] font-medium uppercase text-mute"
      >Agency name</label
    >
    <input
      id="agency"
      name="agency"
      type="text"
      autocomplete="organization"
      maxlength="120"
      class="w-full rounded-lg bg-white px-4 py-3 text-coal ring-1 ring-line-strong placeholder:text-mute/60 outline-none transition focus:ring-2 focus:ring-signal"
      placeholder="Alpine Trails Co."
    />
  </div>

  <div class="mt-5">
    <label for="topic" class="mb-2 block font-mono text-[12px] font-medium uppercase text-mute"
      >What&apos;s this about?</label
    >
    <select
      id="topic"
      name="topic"
      class="w-full rounded-lg bg-white px-4 py-3 text-coal ring-1 ring-line-strong placeholder:text-mute/60 outline-none transition focus:ring-2 focus:ring-signal"
    >
      {TOPICS.map((t) => <option value={t}>{t}</option>)}
    </select>
  </div>

  <div class="mt-5">
    <label for="message" class="mb-2 block font-mono text-[12px] font-medium uppercase text-mute">Message</label
    >
    <textarea
      id="message"
      name="message"
      maxlength="5000"
      required
      rows="5"
      class="w-full rounded-lg bg-white px-4 py-3 text-coal ring-1 ring-line-strong placeholder:text-mute/60 outline-none transition focus:ring-2 focus:ring-signal"
      placeholder="Tell us about your agency and what you're looking for…"
      ></textarea
    >
  </div>

  <button
    type="submit"
    class:list={[
      "mt-8 w-full cursor-pointer rounded-lg bg-signal text-[15px] font-medium text-white transition-colors hover:bg-coal",
      compact ? "py-3" : "py-4",
    ]}
    data-contact-submit
  >
    Send message
  </button>

  <p
    class="mt-4 hidden items-center justify-center gap-2 text-sm font-medium text-emerald-700"
    data-contact-sent
    role="status"
    aria-live="polite"
  >
    <Icon name="check-circle" class="size-4" />
    Thanks — your message is on its way. We&apos;ll reply within one business day.
  </p>
  <p
    class="mt-4 hidden text-center text-sm font-medium text-red-600"
    data-contact-error
    role="alert"
    aria-live="assertive"
  >
    <span data-contact-error-text>Your message didn&apos;t send. Try again, or</span>
    email us at <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="underline underline-offset-2">{CONTACT_EMAIL}</a
    > instead.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const submitBtn = form?.querySelector<HTMLButtonElement>(
    "[data-contact-submit]",
  );
  const sentMsg = form?.querySelector<HTMLElement>("[data-contact-sent]");
  const errorMsg = form?.querySelector<HTMLElement>("[data-contact-error]");
  const errorText = form?.querySelector<HTMLElement>(
    "[data-contact-error-text]",
  );

  // Preselect the topic when arriving from a CTA such as /contact?topic=enterprise.
  const topicParam = new URLSearchParams(location.search).get("topic");
  const topicSelect = form?.querySelector<HTMLSelectElement>("#topic");
  if (topicSelect && topicParam === "enterprise") {
    topicSelect.value = "Enterprise quote";
  }

  const errorCopy = (status: number | null) => {
    if (status === null)
      return "You seem to be offline, so your message didn't send. Your text is still here; try again once you're connected, or";
    if (status === 429)
      return "Too many messages from this connection. Wait 10 minutes and try again, or";
    if (status === 400)
      return "Check your name, email and message, then try again, or";
    return "Your message didn't send because of a problem on our side. Try again in a moment, or";
  };

  // Prefill from ?plan= on the client so the page itself can be prerendered.
  const plan = new URLSearchParams(location.search).get("plan");
  const message = form?.querySelector<HTMLTextAreaElement>("#message");
  if (message && !message.value && (plan === "launch" || plan === "business")) {
    message.value = `I'm interested in the Nepal ${plan === "launch" ? "Launch" : "Business"} plan. Please share the next steps and final tax details.`;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
    sentMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    try {
      const body = new FormData(form);
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(body.entries())),
      });
      const data = (await res.json().catch(() => ({ ok: false }))) as {
        ok: boolean;
      };
      if (!res.ok || !data.ok) {
        if (errorText) errorText.textContent = errorCopy(res.status);
        errorMsg?.classList.remove("hidden");
        return;
      }
      sentMsg?.classList.remove("hidden");
      sentMsg?.classList.add("flex");
      form.reset();
    } catch {
      if (errorText) errorText.textContent = errorCopy(null);
      errorMsg?.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send message";
    }
  });
</script>
