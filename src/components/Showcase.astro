---
import Icon from "./Icon.astro";

const clientSites = [
  [
    "Essence Treks",
    "/clients/essence-treks.webp",
    "https://essencetreksnepal.com",
  ],
  ["Hi Nepal Treks", "/clients/hi-nepal-treks.webp", "https://hinepaltreks.com"],
  [
    "Into Nepal Treks",
    "/clients/into-nepal-treks.webp",
    "https://new.intonepaltreks.com",
  ],
  [
    "Limestone Treks",
    "/clients/limestone-treks.webp",
    "https://limestonetreks.com",
  ],
  ["Lovely Trips", "/clients/lovely-trips.webp", "https://lovelytrips.com.np"],
  [
    "Summit Luxury Treks",
    "/clients/summit-luxury-treks.webp",
    "https://summitluxurytreks.com",
  ],
  [
    "Walkthrough Nepal",
    "/clients/walkthrough-nepal.webp",
    "https://walkthroughnepal.com",
  ],
];
---

<section id="solutions" class="page-container bg-off-white text-center">
  <h2
    class="m-0 mx-auto max-w-3xl font-serif text-[32px] leading-[1.15] text-deep-navy lg:text-[40px]"
  >
    Made for tour operators like you
  </h2>
  <p
    class="m-0 mx-auto mt-4 max-w-xl text-base leading-relaxed text-deep-navy lg:text-lg"
  >
    Explore live agency websites built with TripEleven. Select a card to visit
    the site.
  </p>
  <div
    class="mt-10 grid grid-cols-2 items-start gap-4 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4"
  >
    {
      clientSites.map(([name, img, url]) => (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          class="group block overflow-hidden rounded-xl border border-border bg-card shadow-sm transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-electric"
          aria-label={`Visit ${name}`}
        >
          <img
            class="block h-auto w-full object-contain"
            src={img}
            loading="lazy"
            width="1440"
            height="1800"
            alt={`${name} website`}
          />
          <span class="flex flex-col gap-1 border-t border-border p-4 text-left sm:flex-row sm:items-center sm:justify-between sm:gap-3">
            <span class="text-sm font-semibold text-deep-navy">{name}</span>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-electric group-hover:underline">
              Visit site <Icon name="external-link" class="size-3.5" />
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
