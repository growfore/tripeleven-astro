---
import Icon from "./Icon.astro";

const stats = [
  {
    icon: "package-plus",
    value: "12",
    label: "Trips published",
    tint: "bg-light-blue text-electric",
  },
  {
    icon: "mail",
    value: "24",
    label: "New inquiries",
    tint: "bg-teal-soft text-teal",
  },
  {
    icon: "sparkles",
    value: "AI itinerary ready",
    label: "Save hours of planning",
    tint: "bg-violet-soft text-violet",
  },
  {
    icon: "calendar",
    value: "8",
    label: "Bookings this month",
    tint: "bg-amber-soft text-amber",
  },
] as const;

const statPositions = [
  "left-2 top-[4%] w-36 sm:w-48 xl:-left-12 xl:top-8 xl:w-56 rotate-2",
  "right-2 top-[4%] w-36 sm:w-48 xl:right-8 xl:-top-10 xl:w-56",
  "left-2 top-[80%] w-64 sm:w-52 xl:left-4 xl:top-[88%] xl:w-60 -rotate-2",
  "right-2 bottom-[4%] w-42 sm:w-48 xl:right-20 xl:-bottom-2 xl:w-60 rotate-5",
];

const highlights = [
  { icon: "layers", title: "Trip Management", copy: "Create & manage trips" },
  { icon: "globe", title: "Branded Website", copy: "Showcase your business" },
  {
    icon: "users",
    title: "Inquiries & Bookings",
    copy: "Turn interest into revenue",
  },
  {
    icon: "sparkles",
    title: "AI Itinerary Builder",
    copy: "Save time, create better trips",
  },
  {
    icon: "trending-up",
    title: "Grow Your Business",
    copy: "Less admin, more adventure",
  },
] as const;
---

<section class="relative overflow-hidden bg-off-white pt-10 lg:pt-14">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-[radial-gradient(60%_60%_at_70%_0%,var(--light-blue),transparent)]"
  >
  </div>

  <div class="page-container relative">
    <div class="grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:gap-8">
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full bg-light-blue px-3.5 py-1.5 text-xs font-semibold text-electric"
        >
          <Icon name="zap" class="size-4" />
          Built for Tour &amp; Trekking Operators
        </span>

        <h1
          class="mb-5 mt-6 font-serif text-[clamp(34px,4.2vw,52px)] font-bold leading-[1.05] tracking-[-0.03em] text-deep-navy"
        >
          Run Your Travel Business.
          <span class="block text-electric">Not Your Spreadsheets.</span>
        </h1>

        <p
          class="m-0 max-w-md text-base leading-[1.55] text-deep-navy/75 lg:text-lg"
        >
          Build trips, publish your website, manage inquiries and grow — all in
          one platform.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="https://app.tripeleven.com/signup"
            target="_blank"
            rel="noreferrer"
            class="group inline-flex items-center gap-2 rounded-lg bg-deep-navy px-6 py-3.5 font-semibold text-white transition-colors duration-150 hover:bg-navy active:scale-[0.96]"
          >
            Start free
            <Icon
              name="arrow-right"
              class="size-5 transition-transform duration-200 group-hover:translate-x-1"
            />
          </a>
          <a
            href="#features"
            class="inline-flex items-center gap-2 rounded-lg border border-deep-navy/15 bg-white px-6 py-3.5 font-semibold text-deep-navy transition-colors duration-150 hover:bg-light-blue active:scale-[0.96]"
          >
            <Icon name="circle-play" class="size-5 text-electric" />
            See how it works
          </a>
        </div>
      </div>

      <div class="relative">
        <img
          src="/mockups/hero-image.webp"
          width="1926"
          height="1286"
          alt="TripEleven dashboard for managing trips, bookings and website content"
          class="block w-full rounded-xl border border-border shadow-xl"
          fetchpriority="high"
        />

        <ul class="absolute inset-0">
          {
            stats.map((stat, i) => (
              <li
                data-stat
                class:list={[
                  "absolute flex items-center gap-2.5 rounded-xl border border-border bg-white/95 p-2.5 shadow-lg backdrop-blur lg:gap-3 lg:p-3",
                  statPositions[i],
                ]}
              >
                <span
                  class:list={[
                    "grid size-9 shrink-0 place-items-center rounded-lg lg:size-10",
                    stat.tint,
                  ]}
                >
                  <Icon name={stat.icon} class="size-4.5 lg:size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-deep-navy lg:text-base">
                    {stat.value}
                  </span>
                  <span class="block text-[11px] leading-tight text-deep-navy/60 lg:text-xs lg:leading-snug">
                    {stat.label}
                  </span>
                </span>
                <Icon
                  name="chevron-right"
                  class="ml-auto hidden size-4 text-deep-navy/40 lg:block"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ul
      class="mt-14 grid gap-7 border-t border-deep-navy/10 pt-9 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5 lg:divide-x lg:divide-deep-navy/10"
    >
      {
        highlights.map(({ icon, title, copy }) => (
          <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:last:pr-0">
            <Icon name={icon} class="mt-0.5 size-7 shrink-0 text-electric lg:size-6" />
            <span class="min-w-0">
              <span
                class="block text-base font-semibold text-deep-navy lg:text-sm"
                >{title}</span
              >
              <span
                class="block text-sm leading-snug text-deep-navy/60 lg:text-xs"
                >{copy}</span
              >
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @keyframes stat-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  [data-stat] {
    animation: stat-float 6s ease-in-out infinite;
  }

  [data-stat]:nth-of-type(2) {
    animation-delay: -1.5s;
  }

  [data-stat]:nth-of-type(3) {
    animation-delay: -3s;
  }

  [data-stat]:nth-of-type(4) {
    animation-delay: -4.5s;
  }
</style>
