---
import Icon from "./Icon.astro";

const extras = [
  {
    icon: "layout-grid" as const,
    title: "Catalog",
    text: "Organize everything you offer in one browsable catalog.",
  },
  {
    icon: "package-plus" as const,
    title: "Extras",
    text: "Bundle add-ons and sell them right alongside your trips.",
  },
  {
    icon: "tag" as const,
    title: "Tags",
    text: "Label content and services to keep everything easy to find.",
  },
  {
    icon: "sparkles" as const,
    title: "AI",
    text: "AI assistants that draft, organize, and polish your content.",
  },
];
---

<section class="page-container bg-off-white">
  <div class="text-center">
    <h2
      class="m-0 font-serif text-[32px] leading-[1.15] text-deep-navy lg:text-[40px]"
    >
      Plus everything else you need
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-deep-navy">
      From catalog and menus to analytics, TripEleven covers the rest of your
      setup — no extra tools required.
    </p>
    <div
      class="mt-9 grid grid-cols-1 gap-8 text-left sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        extras.map(({ icon, title, text }) => (
          <article class="border-t border-light-blue pt-5">
            <Icon name={icon} class="size-10 text-electric" />
            <h3 class="m-0 mt-5 font-serif text-[22px] text-deep-navy">
              {title}
            </h3>
            <p class="m-0 mt-2 max-w-xs text-sm leading-relaxed text-deep-navy">
              {text}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
