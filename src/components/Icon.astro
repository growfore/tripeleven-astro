interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const html = paths[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={html}
  aria-hidden="true"
/>