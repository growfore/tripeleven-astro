---
import FloatingNav from "@/components/FloatingNav.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

import "@/styles/global.css";

const SITE_NAME = "TripEleven";
const SITE_URL = "https://tripeleven.com";
const CONTACT_EMAIL = "hello@tripeleven.com";
const OG_IMAGE = `${SITE_URL}/images/hero-trek.jpg`;

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  noindex?: boolean;
  chrome?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  canonical = SITE_URL,
  noindex = false,
  chrome = true,
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      email: CONTACT_EMAIL,
      logo: `${SITE_URL}/lettermark-logo.svg`,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: SITE_URL,
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="theme-color" content="#041D38" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />

    <script is:inline>
      // Consent gate for analytics (GA4), Microsoft Clarity and Tawk.to live
      // chat. Nothing non-essential is requested until te_consent=all, so
      // rejected and essentials-only visitors never hit a third party.
      // ponytail: gate is one cookie read; revisit only if a CMP becomes
      // legally required (e.g. IAB TCF regions).
      window.__teLoadNonEssential = function () {
        if (window.__teNonEssentialLoaded) return;
        window.__teNonEssentialLoaded = true;

        function load(src, attrs) {
          var s = document.createElement("script");
          s.async = true;
          s.src = src;
          for (var k in attrs) s.setAttribute(k, attrs[k]);
          document.head.appendChild(s);
        }

        load("https://www.googletagmanager.com/gtag/js?id=G-H7TRDSVGQ7");
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", "G-H7TRDSVGQ7");

        load("https://www.clarity.ms/tag/y04juop5nc");

        if (window.matchMedia("(min-width: 640px)").matches) {
          load("https://embed.tawk.to/69c90275e246401c3606c780/1k27va0nl", {
            crossorigin: "*",
          });
        }
      };

      if (/(?:^|;\s*)te_consent=all(?:;|$)/.test(document.cookie)) {
        window.__teLoadNonEssential();
      }
    </script>
  </head>
  <body class="m-0 overflow-x-hidden bg-background font-sans text-foreground">
    <a
      href="#top"
      class="fixed left-4 top-3 z-[100] -translate-y-20 rounded-lg bg-white px-4 py-2 font-semibold text-deep-navy shadow-lg transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    {chrome && <FloatingNav />}
    <slot />
    {chrome && <Footer />}
    <CookieBanner />
  </body>
</html>
