---
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/mona-sans";
import "@/styles/global.css";

const SITE_NAME = "TripEleven";
const SITE_URL = "https://tripeleven.com";
const CONTACT_EMAIL = "hello@tripeleven.com";
const DEFAULT_OG_IMAGE = "/og/default.jpg";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  chrome?: boolean;
  autoConsent?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  canonical = SITE_URL,
  ogImage = DEFAULT_OG_IMAGE,
  jsonLd: extraJsonLd = [],
  noindex = false,
  chrome = true,
  autoConsent = false,
} = Astro.props;

const ogImageUrl = new URL(ogImage, SITE_URL).href;
const pageId = `${canonical.replace(/\/$/, "")}/#webpage`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      email: CONTACT_EMAIL,
      logo: `${SITE_URL}/logo.png`,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: SITE_URL,
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": pageId,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    ...extraJsonLd,
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-chat-always={autoConsent ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />

    <script is:inline>
      // Consent gate for analytics (GA4), Microsoft Clarity and Tawk.to live
      // chat. Nothing non-essential is requested until te_consent=all, so
      // rejected and essentials-only visitors never hit a third party.
      // ponytail: gate is one cookie read; revisit only if a CMP becomes
      // legally required (e.g. IAB TCF regions).
      window.__teLoadNonEssential = function () {
        if (window.__teNonEssentialLoaded) return;
        window.__teNonEssentialLoaded = true;

        function load(src, attrs) {
          var s = document.createElement("script");
          s.async = true;
          s.src = src;
          for (var k in attrs) s.setAttribute(k, attrs[k]);
          document.head.appendChild(s);
        }

        load("https://www.googletagmanager.com/gtag/js?id=G-H7TRDSVGQ7");
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", "G-H7TRDSVGQ7");

        // The Clarity tag calls window.clarity() as soon as it runs, so the
        // queue stub must exist first (same as Microsoft's official snippet).
        window.clarity =
          window.clarity ||
          function () {
            (window.clarity.q = window.clarity.q || []).push(arguments);
          };
        // Only reached after "Accept all", so tell Clarity consent was given.
        window.clarity("consentv2", {
          ad_Storage: "granted",
          analytics_Storage: "granted",
        });
        load("https://www.clarity.ms/tag/y04juop5nc");

        // Chat is desktop-only by default; auto-consent pages opt in on every width.
        if (
          document.documentElement.hasAttribute("data-chat-always") ||
          window.matchMedia("(min-width: 640px)").matches
        ) {
          load("https://embed.tawk.to/69c90275e246401c3606c780/1k27va0nl", {
            crossorigin: "*",
          });
        }
      };

      if (/(?:^|;\s*)te_consent=all(?:;|$)/.test(document.cookie)) {
        window.__teLoadNonEssential();
      }
    </script>
    {
      autoConsent && (
        <script is:inline>
          {`// Landing page opts visitors in without a banner: record "all" and load.
          if (!/(?:^|;\\s*)te_consent=/.test(document.cookie)) {
            document.cookie =
              "te_consent=all; path=/; max-age=31536000; samesite=lax" +
              (location.protocol === "https:" ? "; secure" : "");
            window.__teLoadNonEssential();
          }`}
        </script>
      )
    }
  </head>
  <body class="m-0 overflow-x-hidden bg-white font-sans text-coal">
    <a
      href="#top"
      class="fixed left-4 top-3 z-[100] -translate-y-20 rounded-lg bg-white px-4 py-2 font-medium text-coal shadow-lg transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    {chrome && <Header />}
    <slot />
    {chrome && <Footer />}
    {!autoConsent && <CookieBanner />}
  </body>
</html>
