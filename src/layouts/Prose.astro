---
import Layout from "./Layout.astro";

// Markdown pages in src/pages pass their frontmatter under `frontmatter`.
interface Props {
  frontmatter: {
    title: string;
    description: string;
    canonical: string;
    updated: string;
  };
}

const { title, description, canonical, updated } = Astro.props.frontmatter;
const heading = title.split(" — ")[0];
---

<Layout {title} {description} {canonical}>
  <div class="mx-auto w-full max-w-[1510px] overflow-x-clip bg-card">
    <main
      id="top"
      class="prose mx-auto max-w-3xl px-5 pb-[80px] pt-16 lg:px-[55px]"
    >
      <h1 class="mb-8 font-serif text-[32px] leading-tight lg:text-[40px]">
        {heading}
      </h1>
      <p class="mb-6 text-sm leading-[1.8] text-muted-foreground">
        Last updated: {updated}
      </p>
      <slot />
    </main>
  </div>
</Layout>
