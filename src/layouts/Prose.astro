---
import Layout from "./Layout.astro";

// Markdown pages in src/pages pass their frontmatter under `frontmatter`.
interface Props {
  frontmatter: {
    title: string;
    description: string;
    canonical: string;
    updated: string;
  };
}

const { title, description, canonical, updated } = Astro.props.frontmatter;
const heading = title.split(" — ")[0];
---

<Layout {title} {description} {canonical}>
  <div class="mx-auto w-full overflow-x-clip">
    <main
      id="top"
      class="prose mx-auto max-w-3xl px-5 pb-24 pt-16 lg:pt-24"
    >
      <p class="m-0 font-mono text-[13px] uppercase text-signal">Legal</p>
      <h1 class="mb-4 mt-6 font-display text-[40px] font-medium leading-[1.1] tracking-[-0.03em] text-coal lg:text-[56px]">
        {heading}
      </h1>
      <p class="mb-12 font-mono text-[12px] uppercase text-mute">
        Last updated: {updated}
      </p>
      <slot />
    </main>
  </div>
</Layout>
